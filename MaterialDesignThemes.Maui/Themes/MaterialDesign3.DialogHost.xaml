<?xml version="1.0" encoding="UTF-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    xmlns:styling="clr-namespace:MaterialDesignThemes.Maui;assembly=MaterialDesignThemes.Maui">

  <Style x:Key="MaterialDesignDialogHost"
         TargetType="styling:DialogHost">
    <Setter Property="DialogMargin" Value="24" />
    <Setter Property="DialogPadding" Value="24" />
    <Setter Property="DialogCornerRadius" Value="12" />
    <Setter Property="OverlayBackground">
      <Setter.Value>
        <SolidColorBrush Color="{DynamicResource Key={x:Static styling:MaterialDesignColorKey.Scrim}}" />
      </Setter.Value>
    </Setter>
    <Setter Property="DialogBackground">
      <Setter.Value>
        <SolidColorBrush Color="{DynamicResource Key={x:Static styling:MaterialDesignColorKey.SurfaceContainerHigh}}" />
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="styling:DialogHost"
         BasedOn="{StaticResource MaterialDesignDialogHost}" />
</ResourceDictionary>
