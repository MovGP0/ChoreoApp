<?xml version="1.0" encoding="UTF-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    xmlns:choreoApp="clr-namespace:MaterialDesignThemes.Maui;assembly=MaterialDesignThemes.Maui">

  <!--
    Material Design 3 inspired typography styles for MAUI Label elements.
    The keys mirror the WPF MaterialDesign3.TextBlock and Hyperlink resources
    to ease reuse across platforms.
  -->

  <!-- Body -->
  <Style x:Key="MaterialDesignBodySmallTextBlock"
         TargetType="Label">
    <Setter Property="TextColor" Value="{DynamicResource Key={x:Static choreoApp:MaterialDesignColorKey.OnSurface}}" />
    <Setter Property="FontFamily" Value="OpenSansRegular" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="LineHeight" Value="1.333" />
  </Style>
  <Style x:Key="MaterialDesignBodyMediumTextBlock"
         TargetType="Label">
    <Setter Property="TextColor" Value="{DynamicResource Key={x:Static choreoApp:MaterialDesignColorKey.OnSurface}}" />
    <Setter Property="FontFamily" Value="OpenSansRegular" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="LineHeight" Value="1.429" />
  </Style>
  <Style x:Key="MaterialDesignBodyLargeTextBlock"
         TargetType="Label">
    <Setter Property="TextColor" Value="{DynamicResource Key={x:Static choreoApp:MaterialDesignColorKey.OnSurface}}" />
    <Setter Property="FontFamily" Value="OpenSansRegular" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="LineHeight" Value="1.500" />
  </Style>

  <!-- Label -->
  <Style x:Key="MaterialDesignLabelSmallTextBlock"
         TargetType="Label">
    <Setter Property="TextColor" Value="{DynamicResource Key={x:Static choreoApp:MaterialDesignColorKey.OnSurface}}" />
    <Setter Property="FontFamily" Value="OpenSansSemibold" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="LineHeight" Value="1.455" />
  </Style>
  <Style x:Key="MaterialDesignLabelMediumTextBlock"
         TargetType="Label">
    <Setter Property="TextColor" Value="{DynamicResource Key={x:Static choreoApp:MaterialDesignColorKey.OnSurface}}" />
    <Setter Property="FontFamily" Value="OpenSansSemibold" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="LineHeight" Value="1.333" />
  </Style>
  <Style x:Key="MaterialDesignLabelLargeTextBlock"
         TargetType="Label">
    <Setter Property="TextColor" Value="{DynamicResource Key={x:Static choreoApp:MaterialDesignColorKey.OnSurface}}" />
    <Setter Property="FontFamily" Value="OpenSansSemibold" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="LineHeight" Value="1.429" />
  </Style>

  <!-- Title -->
  <Style x:Key="MaterialDesignTitleSmallTextBlock"
         TargetType="Label">
    <Setter Property="TextColor" Value="{DynamicResource Key={x:Static choreoApp:MaterialDesignColorKey.OnSurface}}" />
    <Setter Property="FontFamily" Value="OpenSansSemibold" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="LineHeight" Value="1.429" />
  </Style>
  <Style x:Key="MaterialDesignTitleMediumTextBlock"
         TargetType="Label">
    <Setter Property="TextColor" Value="{DynamicResource Key={x:Static choreoApp:MaterialDesignColorKey.OnSurface}}" />
    <Setter Property="FontFamily" Value="OpenSansSemibold" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="LineHeight" Value="1.500" />
  </Style>
  <Style x:Key="MaterialDesignTitleLargeTextBlock"
         TargetType="Label">
    <Setter Property="TextColor" Value="{DynamicResource Key={x:Static choreoApp:MaterialDesignColorKey.OnSurface}}" />
    <Setter Property="FontFamily" Value="OpenSansSemibold" />
    <Setter Property="FontSize" Value="22" />
    <Setter Property="LineHeight" Value="1.273" />
  </Style>

  <!-- Headline -->
  <Style x:Key="MaterialDesignHeadlineSmallTextBlock"
         TargetType="Label">
    <Setter Property="TextColor" Value="{DynamicResource Key={x:Static choreoApp:MaterialDesignColorKey.OnSurface}}" />
    <Setter Property="FontFamily" Value="OpenSansRegular" />
    <Setter Property="FontSize" Value="24" />
    <Setter Property="LineHeight" Value="1.333" />
  </Style>
  <Style x:Key="MaterialDesignHeadlineMediumTextBlock"
         TargetType="Label">
    <Setter Property="TextColor" Value="{DynamicResource Key={x:Static choreoApp:MaterialDesignColorKey.OnSurface}}" />
    <Setter Property="FontFamily" Value="OpenSansRegular" />
    <Setter Property="FontSize" Value="28" />
    <Setter Property="LineHeight" Value="1.286" />
  </Style>
  <Style x:Key="MaterialDesignHeadlineLargeTextBlock"
         TargetType="Label">
    <Setter Property="TextColor" Value="{DynamicResource Key={x:Static choreoApp:MaterialDesignColorKey.OnSurface}}" />
    <Setter Property="FontFamily" Value="OpenSansRegular" />
    <Setter Property="FontSize" Value="32" />
    <Setter Property="LineHeight" Value="1.250" />
  </Style>

  <!-- Display -->
  <Style x:Key="MaterialDesignDisplaySmallTextBlock"
         TargetType="Label">
    <Setter Property="TextColor" Value="{DynamicResource Key={x:Static choreoApp:MaterialDesignColorKey.OnSurface}}" />
    <Setter Property="FontFamily" Value="OpenSansRegular" />
    <Setter Property="FontSize" Value="36" />
    <Setter Property="LineHeight" Value="1.222" />
  </Style>
  <Style x:Key="MaterialDesignDisplayMediumTextBlock"
         TargetType="Label">
    <Setter Property="TextColor" Value="{DynamicResource Key={x:Static choreoApp:MaterialDesignColorKey.OnSurface}}" />
    <Setter Property="FontFamily" Value="OpenSansRegular" />
    <Setter Property="FontSize" Value="45" />
    <Setter Property="LineHeight" Value="1.156" />
  </Style>
  <Style x:Key="MaterialDesignDisplayLargeTextBlock"
         TargetType="Label">
    <Setter Property="TextColor" Value="{DynamicResource Key={x:Static choreoApp:MaterialDesignColorKey.OnSurface}}" />
    <Setter Property="FontFamily" Value="OpenSansRegular" />
    <Setter Property="FontSize" Value="57" />
    <Setter Property="LineHeight" Value="1.123" />
  </Style>

  <!-- Hyperlinks (apply to Label and add a TapGestureRecognizer in usage) -->
  <Style x:Key="MaterialDesignBody1Hyperlink"
         TargetType="Label">
    <Setter Property="TextColor" Value="{DynamicResource Key={x:Static choreoApp:MaterialDesignColorKey.OnSurface}}" />
    <Setter Property="FontFamily" Value="OpenSansRegular" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="LineHeight" Value="1.250" />
    <Setter Property="TextDecorations" Value="None" />
    <Setter Property="VisualStateManager.VisualStateGroups">
      <VisualStateGroupList>
        <VisualStateGroup x:Name="CommonStates">
          <VisualState x:Name="Normal" />
          <VisualState x:Name="Disabled">
            <VisualState.Setters>
              <Setter Property="TextColor" Value="{DynamicResource Key={x:Static choreoApp:MaterialDesignColorKey.OnSurfaceVariant}}" />
              <Setter Property="TextDecorations" Value="None" />
              <Setter Property="Opacity" Value="0.6" />
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="PointerOver">
            <VisualState.Setters>
              <Setter Property="TextDecorations" Value="Underline" />
            </VisualState.Setters>
          </VisualState>
        </VisualStateGroup>
      </VisualStateGroupList>
    </Setter>
  </Style>

  <Style x:Key="MaterialDesignBody2Hyperlink}"
         TargetType="Label"
         BasedOn="{StaticResource MaterialDesignBody1Hyperlink}">
    <Setter Property="FontSize" Value="14" />
  </Style>

  <Style x:Key="MaterialDesignCaptionHyperlink}"
         TargetType="Label"
         BasedOn="{StaticResource MaterialDesignBody1Hyperlink}">
    <Setter Property="FontSize" Value="12" />
  </Style>

  <Style x:Key="MaterialDesignOverlineHyperlink}"
         TargetType="Label"
         BasedOn="{StaticResource MaterialDesignBody1Hyperlink}">
    <Setter Property="FontSize" Value="10" />
  </Style>

  <Style x:Key="MaterialDesignSubtitle1Hyperlink}"
         TargetType="Label"
         BasedOn="{StaticResource MaterialDesignBody1Hyperlink}">
    <Setter Property="FontSize" Value="16" />
  </Style>

  <Style x:Key="MaterialDesignSubtitle2Hyperlink}"
         TargetType="Label"
         BasedOn="{StaticResource MaterialDesignBody1Hyperlink}">
    <Setter Property="FontFamily" Value="OpenSansSemibold" />
    <Setter Property="FontSize" Value="14" />
  </Style>

  <Style x:Key="MaterialDesignHeadline6Hyperlink}"
         TargetType="Label"
         BasedOn="{StaticResource MaterialDesignBody1Hyperlink}">
    <Setter Property="FontFamily" Value="OpenSansSemibold" />
    <Setter Property="FontSize" Value="20" />
  </Style>

  <Style x:Key="MaterialDesignHeadline5Hyperlink}"
         TargetType="Label"
         BasedOn="{StaticResource MaterialDesignBody1Hyperlink}">
    <Setter Property="FontSize" Value="24" />
  </Style>

  <Style x:Key="MaterialDesignHeadline4Hyperlink}"
         TargetType="Label"
         BasedOn="{StaticResource MaterialDesignBody1Hyperlink}">
    <Setter Property="FontSize" Value="34" />
  </Style>

  <Style x:Key="MaterialDesignHeadline3Hyperlink}"
         TargetType="Label"
         BasedOn="{StaticResource MaterialDesignBody1Hyperlink}">
    <Setter Property="FontSize" Value="48" />
  </Style>

  <Style x:Key="MaterialDesignHeadline2Hyperlink}"
         TargetType="Label"
         BasedOn="{StaticResource MaterialDesignBody1Hyperlink}">
    <Setter Property="FontSize" Value="60" />
  </Style>

  <Style x:Key="MaterialDesignHeadline1Hyperlink}"
         TargetType="Label"
         BasedOn="{StaticResource MaterialDesignBody1Hyperlink}">
    <Setter Property="FontSize" Value="96" />
  </Style>

</ResourceDictionary>
