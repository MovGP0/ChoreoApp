<?xml version="1.0" encoding="UTF-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    xmlns:styling="clr-namespace:MaterialDesignThemes.Maui;assembly=MaterialDesignThemes.Maui">

  <Style x:Key="MaterialDesignListView"
         TargetType="ListView">
    <Setter Property="BackgroundColor"
            Value="{DynamicResource Key={x:Static styling:MaterialDesignColorKey.Surface}}" />
    <Setter Property="SeparatorColor"
            Value="{DynamicResource Key={x:Static styling:MaterialDesignColorKey.OutlineVariant}}" />
    <Setter Property="SeparatorVisibility" Value="Default" />
    <Setter Property="styling:ListViewAssist.ListViewItemPadding" Value="8" />
    <Setter Property="styling:ListViewAssist.AnimateSelection" Value="True" />
    <Setter Property="styling:ListViewAssist.SelectionAnimationDuration" Value="140" />
    <Setter Property="styling:ListViewAssist.SelectionScale" Value="0.96" />
  </Style>

  <Style TargetType="ListView"
         BasedOn="{StaticResource MaterialDesignListView}" />
</ResourceDictionary>
