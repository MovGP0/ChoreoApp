<?xml version="1.0" encoding="utf-8" ?>
<maui:ReactiveContentPage x:TypeArguments="fields:FieldsViewModel"
                          xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                          xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                          xmlns:fields="clr-namespace:MaterialDesignDemo.Maui.Fields"
                          xmlns:maui="using:ReactiveUI.Maui"
                          xmlns:styling="clr-namespace:MaterialDesignThemes.Maui;assembly=MaterialDesignThemes.Maui"
                          x:Class="MaterialDesignDemo.Maui.Fields.FieldsPage"
                          x:DataType="fields:FieldsViewModel">
  <ScrollView>
    <VerticalStackLayout Padding="24" Spacing="16">
      <Label Style="{StaticResource MaterialDesignHeadlineMediumTextBlock}" Text="Fields" />

      <Entry Placeholder="Name"
             Style="{StaticResource MaterialDesignFilledEntry}"
             Text="{Binding Name}" />

      <Entry Placeholder="Email"
             Keyboard="Email"
             Style="{StaticResource MaterialDesignOutlinedEntry}"
             Text="{Binding Email}" />

      <Editor Placeholder="Notes"
              Style="{StaticResource MaterialDesignTextBoxMultiLine}"
              Text="{Binding Notes}" />
    </VerticalStackLayout>
  </ScrollView>
</maui:ReactiveContentPage>
