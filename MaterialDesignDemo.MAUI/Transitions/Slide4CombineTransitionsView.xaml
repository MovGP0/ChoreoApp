<?xml version="1.0" encoding="utf-8" ?>
<maui:ReactiveContentView x:TypeArguments="transitions:TransitionsDemoViewModel"
                          xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                          xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                          xmlns:maui="using:ReactiveUI.Maui"
                          xmlns:styling="clr-namespace:MaterialDesignThemes.Maui;assembly=MaterialDesignThemes.Maui"
                          xmlns:transitions="clr-namespace:MaterialDesignDemo.MAUI.Transitions"
                          x:Class="MaterialDesignDemo.MAUI.Transitions.Slide4CombineTransitionsView"
                          x:DataType="transitions:TransitionsDemoViewModel">
  <styling:ColorZone Mode="Dark">
    <VerticalStackLayout Margin="64" Spacing="16">
      <Label Style="{StaticResource MaterialDesignHeadlineSmallTextBlock}"
             Text="You can combine some transition effects too. Did you see how this page slid in from the bottom and left?"
             LineBreakMode="WordWrap" />
      <Label Style="{StaticResource MaterialDesignTitleMediumTextBlock}"
             Text="Next we will look at some granular transitions on individual elements."
             LineBreakMode="WordWrap" />
      <HorizontalStackLayout Spacing="16">
        <styling:ContentButton Style="{StaticResource MaterialDesignIconButton}"
                               Command="{Binding MovePreviousCommand}">
          <styling:PackIcon Kind="StepBackward" />
        </styling:ContentButton>
        <styling:ContentButton Style="{StaticResource MaterialDesignIconButton}"
                               Command="{Binding MoveNextCommand}">
          <styling:PackIcon Kind="StepForward" />
        </styling:ContentButton>
      </HorizontalStackLayout>
    </VerticalStackLayout>
  </styling:ColorZone>
</maui:ReactiveContentView>
