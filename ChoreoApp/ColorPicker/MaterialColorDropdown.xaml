<?xml version="1.0" encoding="utf-8" ?>
<ContentView x:Name="Root"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:styling="clr-namespace:MaterialDesignThemes.Maui;assembly=MaterialDesignThemes.Maui"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:colorPicker="clr-namespace:ChoreoApp.ColorPicker"
             x:DataType="colorPicker:MaterialColorDropdown"
             x:Class="ChoreoApp.ColorPicker.MaterialColorDropdown">
    <toolkit:Expander IsExpanded="{Binding IsExpanded, Source={x:Reference Root}, Mode=TwoWay}">
        <toolkit:Expander.Header>
            <Border Stroke="{DynamicResource Key={x:Static styling:MaterialDesignColorKey.Outline}}"
                    StrokeThickness="1"
                    BackgroundColor="{DynamicResource Key={x:Static styling:MaterialDesignColorKey.Surface}}"
                    Padding="12,8">
                <Grid ColumnDefinitions="Auto,Auto"
                      ColumnSpacing="8"
                      VerticalOptions="Center">
                    <BoxView WidthRequest="20"
                             HeightRequest="20"
                             CornerRadius="4"
                             Color="{Binding SelectedColor, Source={x:Reference Root}}"
                             VerticalOptions="Center" />
                    <Label Grid.Column="1"
                           Text="v"
                           FontSize="12"
                           VerticalOptions="Center"
                           TextColor="{DynamicResource Key={x:Static styling:MaterialDesignColorKey.OnSurfaceVariant}}" />
                </Grid>
            </Border>
        </toolkit:Expander.Header>
        <toolkit:Expander.Content>
            <Border Stroke="{DynamicResource Key={x:Static styling:MaterialDesignColorKey.Outline}}"
                    StrokeThickness="1"
                    BackgroundColor="{DynamicResource Key={x:Static styling:MaterialDesignColorKey.Surface}}"
                    Padding="8">
                <ScrollView>
                    <FlexLayout BindableLayout.ItemsSource="{Binding FlatItems, Source={x:Reference Root}}"
                                Direction="Row"
                                Wrap="Wrap"
                                AlignItems="Start"
                                AlignContent="Start"
                                JustifyContent="Start">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="colorPicker:MaterialColorOption">
                                <Border WidthRequest="28"
                                        HeightRequest="28"
                                        BackgroundColor="{Binding Color}"
                                        Stroke="{DynamicResource Key={x:Static styling:MaterialDesignColorKey.Outline}}"
                                        StrokeThickness="1"
                                        Margin="4">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnColorTapped" />
                                    </Border.GestureRecognizers>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>
                </ScrollView>
            </Border>
        </toolkit:Expander.Content>
    </toolkit:Expander>
</ContentView>
