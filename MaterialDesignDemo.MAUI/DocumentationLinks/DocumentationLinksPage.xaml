<?xml version="1.0" encoding="utf-8" ?>
<maui:ReactiveContentPage x:TypeArguments="docs:DocumentationLinksViewModel"
                          xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                          xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                          xmlns:docs="clr-namespace:MaterialDesignDemo.Maui.DocumentationLinks"
                          xmlns:maui="using:ReactiveUI.Maui"
                          xmlns:styling="clr-namespace:MaterialDesignThemes.Maui;assembly=MaterialDesignThemes.Maui"
                          x:Class="MaterialDesignDemo.Maui.DocumentationLinks.DocumentationLinksPage"
                          x:DataType="docs:DocumentationLinksViewModel">
  <ScrollView>
    <VerticalStackLayout Padding="24" Spacing="16">
      <Label Style="{StaticResource MaterialDesignHeadlineMediumTextBlock}" Text="Documentation links" />

      <CollectionView ItemsSource="{Binding Documentation}">
        <CollectionView.ItemTemplate>
          <DataTemplate x:DataType="docs:DocumentationLink">
            <styling:ContentButton Style="{StaticResource MaterialDesignTextButton}"
                                   Command="{Binding Source={RelativeSource AncestorType={x:Type docs:DocumentationLinksPage}}, Path=BindingContext.OpenLinkCommand}"
                                   CommandParameter="{Binding .}">
              <HorizontalStackLayout Spacing="8">
                <styling:PackIcon x:Name="LinkIcon" Kind="BookOpenVariant">
                  <styling:PackIcon.Triggers>
                    <DataTrigger TargetType="styling:PackIcon"
                                 Binding="{Binding Type}"
                                 Value="DemoPageSource">
                      <Setter Property="Kind" Value="Xml" />
                    </DataTrigger>
                    <DataTrigger TargetType="styling:PackIcon"
                                 Binding="{Binding Type}"
                                 Value="StyleSource">
                      <Setter Property="Kind" Value="Brush" />
                    </DataTrigger>
                    <DataTrigger TargetType="styling:PackIcon"
                                 Binding="{Binding Type}"
                                 Value="Video">
                      <Setter Property="Kind" Value="YoutubePlay" />
                    </DataTrigger>
                    <DataTrigger TargetType="styling:PackIcon"
                                 Binding="{Binding Type}"
                                 Value="ControlSource">
                      <Setter Property="Kind" Value="CodeBraces" />
                    </DataTrigger>
                    <DataTrigger TargetType="styling:PackIcon"
                                 Binding="{Binding Type}"
                                 Value="Specs">
                      <Setter Property="Kind" Value="MaterialDesign" />
                    </DataTrigger>
                  </styling:PackIcon.Triggers>
                </styling:PackIcon>
                <Label Text="{Binding Label}" Style="{StaticResource MaterialDesignBodyMediumTextBlock}" />
              </HorizontalStackLayout>
            </styling:ContentButton>
          </DataTemplate>
        </CollectionView.ItemTemplate>
      </CollectionView>
    </VerticalStackLayout>
  </ScrollView>
</maui:ReactiveContentPage>
