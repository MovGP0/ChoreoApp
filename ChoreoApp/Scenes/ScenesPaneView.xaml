<?xml version="1.0" encoding="utf-8" ?>
<maui:ReactiveContentView x:TypeArguments="scenes:ScenesPaneViewModel"
                          xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                          xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                          xmlns:maui="using:ReactiveUI.Maui"
                          xmlns:styling="clr-namespace:ChoreoApp.Styling;assembly=ChoreoApp.Styling"
                          xmlns:choreoApp="using:ChoreoApp"
                          xmlns:scenes="clr-namespace:ChoreoApp.Scenes"
                          x:Class="ChoreoApp.Scenes.ScenesPaneView">
    <Border x:DataType="scenes:ScenesPaneViewModel"
            StrokeThickness="0"
            BackgroundColor="{DynamicResource Key={x:Static styling:MaterialDesignColorKey.SurfaceVariant}}"
            Padding="12,16"
            MaximumWidthRequest="600">
        <Grid RowDefinitions="*,Auto,Auto">
            <CollectionView Grid.Row="0"
                            ItemsSource="{Binding Scenes}"
                            SelectionMode="None">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout ItemSpacing="8"
                                       Orientation="Vertical" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="choreoApp:SceneViewModel">
                        <Border StrokeThickness="1"
                                Stroke="{DynamicResource Key={x:Static styling:MaterialDesignColorKey.OutlineVariant}}"
                                BackgroundColor="{DynamicResource Key={x:Static styling:MaterialDesignColorKey.Surface}}"
                                Padding="10"
                                StrokeShape="RoundRectangle 6">
                            <Grid ColumnDefinitions="*"
                                  Padding="4">
                                <Label Text="{Binding Name}"
                                       FontAttributes="Bold"
                                       VerticalOptions="Center"
                                       TextColor="{DynamicResource Key={x:Static styling:MaterialDesignColorKey.OnSurface}}"
                                       BackgroundColor="{DynamicResource Key={x:Static styling:MaterialDesignColorKey.Surface}}" />
                            </Grid>
                            <Border.GestureRecognizers>
                                <DragGestureRecognizer CanDrag="True"
                                                       DragStarting="OnNavItemDragStarting" />
                                <DropGestureRecognizer AllowDrop="True"
                                                       DragOver="OnNavItemDragOver"
                                                       Drop="OnNavItemDrop" />
                            </Border.GestureRecognizers>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
            <Grid Grid.Row="1"
                  ColumnDefinitions="*"
                  Margin="0,12,0,0"
                  ColumnSpacing="8">
                <SearchBar Grid.Column="0"
                           Placeholder="Search"
                           Text="{Binding SearchText, Mode=TwoWay}" />
            </Grid>
            <Grid Grid.Row="2"
                  ColumnDefinitions="*,Auto,Auto,Auto"
                  Margin="0,12,0,0"
                  ColumnSpacing="8">
                <styling:ContentButton Grid.Column="1"
                                       Style="{StaticResource MaterialDesignFlatButton}"
                                       Command="{Binding OpenChoreoCommand}">
                    <styling:PackIcon Kind="FolderOpen"
                                      Foreground="{DynamicResource Key={x:Static styling:MaterialDesignColorKey.OnSurface}}"
                                      BackgroundColor="Transparent" />
                </styling:ContentButton>
                <styling:ContentButton Grid.Column="2"
                                       Style="{StaticResource MaterialDesignFlatDarkButton}"
                                       Command="{Binding NavigateToSettingsCommand}">
                    <styling:PackIcon Kind="Settings"
                                      Foreground="{DynamicResource Key={x:Static styling:MaterialDesignColorKey.OnSurface}}"
                                      BackgroundColor="Transparent" />
                </styling:ContentButton>
                <styling:ContentButton Grid.Column="3"
                                       Style="{StaticResource MaterialDesignFlatDarkButton}"
                                       Command="{Binding NavigateToAudioPlayerCommand}">
                    <styling:PackIcon Kind="PlayCircle"
                                      Foreground="{DynamicResource Key={x:Static styling:MaterialDesignColorKey.OnSurface}}"
                                      BackgroundColor="Transparent" />
                </styling:ContentButton>
            </Grid>
        </Grid>
    </Border>
</maui:ReactiveContentView>
