<?xml version="1.0" encoding="UTF-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    xmlns:choreoApp="clr-namespace:ChoreoApp.Styling;assembly=ChoreoApp.Styling">

  <!--
    Material Design 3 inspired typography styles for MAUI Label elements.
    The keys mirror the WPF MaterialDesign3.TextBlock and Hyperlink resources
    to ease reuse across platforms.
  -->

  <!-- Body -->
  <Style x:Key="{x:Static choreoApp:MaterialDesignStyleKey.MaterialDesignBodySmallTextBlock}"
         TargetType="Label">
    <Setter Property="TextColor" Value="{DynamicResource Key={x:Static choreoApp:MaterialDesignColorKey.OnSurface}}" />
    <Setter Property="FontFamily" Value="OpenSansRegular" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="LineHeight" Value="1.333" />
  </Style>
  <Style x:Key="{x:Static choreoApp:MaterialDesignStyleKey.MaterialDesignBodyMediumTextBlock}"
         TargetType="Label">
    <Setter Property="TextColor" Value="{DynamicResource Key={x:Static choreoApp:MaterialDesignColorKey.OnSurface}}" />
    <Setter Property="FontFamily" Value="OpenSansRegular" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="LineHeight" Value="1.429" />
  </Style>
  <Style x:Key="{x:Static choreoApp:MaterialDesignStyleKey.MaterialDesignBodyLargeTextBlock}"
         TargetType="Label">
    <Setter Property="TextColor" Value="{DynamicResource Key={x:Static choreoApp:MaterialDesignColorKey.OnSurface}}" />
    <Setter Property="FontFamily" Value="OpenSansRegular" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="LineHeight" Value="1.500" />
  </Style>

  <!-- Label -->
  <Style x:Key="{x:Static choreoApp:MaterialDesignStyleKey.MaterialDesignLabelSmallTextBlock}"
         TargetType="Label">
    <Setter Property="TextColor" Value="{DynamicResource Key={x:Static choreoApp:MaterialDesignColorKey.OnSurface}}" />
    <Setter Property="FontFamily" Value="OpenSansSemibold" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="LineHeight" Value="1.455" />
  </Style>
  <Style x:Key="{x:Static choreoApp:MaterialDesignStyleKey.MaterialDesignLabelMediumTextBlock}"
         TargetType="Label">
    <Setter Property="TextColor" Value="{DynamicResource Key={x:Static choreoApp:MaterialDesignColorKey.OnSurface}}" />
    <Setter Property="FontFamily" Value="OpenSansSemibold" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="LineHeight" Value="1.333" />
  </Style>
  <Style x:Key="{x:Static choreoApp:MaterialDesignStyleKey.MaterialDesignLabelLargeTextBlock}"
         TargetType="Label">
    <Setter Property="TextColor" Value="{DynamicResource Key={x:Static choreoApp:MaterialDesignColorKey.OnSurface}}" />
    <Setter Property="FontFamily" Value="OpenSansSemibold" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="LineHeight" Value="1.429" />
  </Style>

  <!-- Title -->
  <Style x:Key="{x:Static choreoApp:MaterialDesignStyleKey.MaterialDesignTitleSmallTextBlock}"
         TargetType="Label">
    <Setter Property="TextColor" Value="{DynamicResource Key={x:Static choreoApp:MaterialDesignColorKey.OnSurface}}" />
    <Setter Property="FontFamily" Value="OpenSansSemibold" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="LineHeight" Value="1.429" />
  </Style>
  <Style x:Key="{x:Static choreoApp:MaterialDesignStyleKey.MaterialDesignTitleMediumTextBlock}"
         TargetType="Label">
    <Setter Property="TextColor" Value="{DynamicResource Key={x:Static choreoApp:MaterialDesignColorKey.OnSurface}}" />
    <Setter Property="FontFamily" Value="OpenSansSemibold" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="LineHeight" Value="1.500" />
  </Style>
  <Style x:Key="{x:Static choreoApp:MaterialDesignStyleKey.MaterialDesignTitleLargeTextBlock}"
         TargetType="Label">
    <Setter Property="TextColor" Value="{DynamicResource Key={x:Static choreoApp:MaterialDesignColorKey.OnSurface}}" />
    <Setter Property="FontFamily" Value="OpenSansSemibold" />
    <Setter Property="FontSize" Value="22" />
    <Setter Property="LineHeight" Value="1.273" />
  </Style>

  <!-- Headline -->
  <Style x:Key="{x:Static choreoApp:MaterialDesignStyleKey.MaterialDesignHeadlineSmallTextBlock}"
         TargetType="Label">
    <Setter Property="TextColor" Value="{DynamicResource Key={x:Static choreoApp:MaterialDesignColorKey.OnSurface}}" />
    <Setter Property="FontFamily" Value="OpenSansRegular" />
    <Setter Property="FontSize" Value="24" />
    <Setter Property="LineHeight" Value="1.333" />
  </Style>
  <Style x:Key="{x:Static choreoApp:MaterialDesignStyleKey.MaterialDesignHeadlineMediumTextBlock}"
         TargetType="Label">
    <Setter Property="TextColor" Value="{DynamicResource Key={x:Static choreoApp:MaterialDesignColorKey.OnSurface}}" />
    <Setter Property="FontFamily" Value="OpenSansRegular" />
    <Setter Property="FontSize" Value="28" />
    <Setter Property="LineHeight" Value="1.286" />
  </Style>
  <Style x:Key="{x:Static choreoApp:MaterialDesignStyleKey.MaterialDesignHeadlineLargeTextBlock}"
         TargetType="Label">
    <Setter Property="TextColor" Value="{DynamicResource Key={x:Static choreoApp:MaterialDesignColorKey.OnSurface}}" />
    <Setter Property="FontFamily" Value="OpenSansRegular" />
    <Setter Property="FontSize" Value="32" />
    <Setter Property="LineHeight" Value="1.250" />
  </Style>

  <!-- Display -->
  <Style x:Key="{x:Static choreoApp:MaterialDesignStyleKey.MaterialDesignDisplaySmallTextBlock}"
         TargetType="Label">
    <Setter Property="TextColor" Value="{DynamicResource Key={x:Static choreoApp:MaterialDesignColorKey.OnSurface}}" />
    <Setter Property="FontFamily" Value="OpenSansRegular" />
    <Setter Property="FontSize" Value="36" />
    <Setter Property="LineHeight" Value="1.222" />
  </Style>
  <Style x:Key="{x:Static choreoApp:MaterialDesignStyleKey.MaterialDesignDisplayMediumTextBlock}"
         TargetType="Label">
    <Setter Property="TextColor" Value="{DynamicResource Key={x:Static choreoApp:MaterialDesignColorKey.OnSurface}}" />
    <Setter Property="FontFamily" Value="OpenSansRegular" />
    <Setter Property="FontSize" Value="45" />
    <Setter Property="LineHeight" Value="1.156" />
  </Style>
  <Style x:Key="{x:Static choreoApp:MaterialDesignStyleKey.MaterialDesignDisplayLargeTextBlock}"
         TargetType="Label">
    <Setter Property="TextColor" Value="{DynamicResource Key={x:Static choreoApp:MaterialDesignColorKey.OnSurface}}" />
    <Setter Property="FontFamily" Value="OpenSansRegular" />
    <Setter Property="FontSize" Value="57" />
    <Setter Property="LineHeight" Value="1.123" />
  </Style>

  <!-- Hyperlinks (apply to Label and add a TapGestureRecognizer in usage) -->
  <Style x:Key="{x:Static choreoApp:MaterialDesignStyleKey.MaterialDesignBody1Hyperlink}"
         TargetType="Label">
    <Setter Property="TextColor" Value="{DynamicResource Key={x:Static choreoApp:MaterialDesignColorKey.OnSurface}}" />
    <Setter Property="FontFamily" Value="OpenSansRegular" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="LineHeight" Value="1.250" />
    <Setter Property="TextDecorations" Value="None" />
    <Setter Property="VisualStateManager.VisualStateGroups">
      <VisualStateGroupList>
        <VisualStateGroup x:Name="CommonStates">
          <VisualState x:Name="Normal" />
          <VisualState x:Name="Disabled">
            <VisualState.Setters>
              <Setter Property="TextColor" Value="{DynamicResource Key={x:Static choreoApp:MaterialDesignColorKey.OnSurfaceVariant}}" />
              <Setter Property="TextDecorations" Value="None" />
              <Setter Property="Opacity" Value="0.6" />
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="PointerOver">
            <VisualState.Setters>
              <Setter Property="TextDecorations" Value="Underline" />
            </VisualState.Setters>
          </VisualState>
        </VisualStateGroup>
      </VisualStateGroupList>
    </Setter>
  </Style>

  <Style x:Key="{x:Static choreoApp:MaterialDesignStyleKey.MaterialDesignBody2Hyperlink}"
         TargetType="Label"
         BasedOn="{StaticResource {x:Static choreoApp:MaterialDesignStyleKey.MaterialDesignBody1Hyperlink}}">
    <Setter Property="FontSize" Value="14" />
  </Style>

  <Style x:Key="{x:Static choreoApp:MaterialDesignStyleKey.MaterialDesignCaptionHyperlink}"
         TargetType="Label"
         BasedOn="{StaticResource {x:Static choreoApp:MaterialDesignStyleKey.MaterialDesignBody1Hyperlink}}">
    <Setter Property="FontSize" Value="12" />
  </Style>

  <Style x:Key="{x:Static choreoApp:MaterialDesignStyleKey.MaterialDesignOverlineHyperlink}"
         TargetType="Label"
         BasedOn="{StaticResource {x:Static choreoApp:MaterialDesignStyleKey.MaterialDesignBody1Hyperlink}}">
    <Setter Property="FontSize" Value="10" />
  </Style>

  <Style x:Key="{x:Static choreoApp:MaterialDesignStyleKey.MaterialDesignSubtitle1Hyperlink}"
         TargetType="Label"
         BasedOn="{StaticResource {x:Static choreoApp:MaterialDesignStyleKey.MaterialDesignBody1Hyperlink}}">
    <Setter Property="FontSize" Value="16" />
  </Style>

  <Style x:Key="{x:Static choreoApp:MaterialDesignStyleKey.MaterialDesignSubtitle2Hyperlink}"
         TargetType="Label"
         BasedOn="{StaticResource {x:Static choreoApp:MaterialDesignStyleKey.MaterialDesignBody1Hyperlink}}">
    <Setter Property="FontFamily" Value="OpenSansSemibold" />
    <Setter Property="FontSize" Value="14" />
  </Style>

  <Style x:Key="{x:Static choreoApp:MaterialDesignStyleKey.MaterialDesignHeadline6Hyperlink}"
         TargetType="Label"
         BasedOn="{StaticResource {x:Static choreoApp:MaterialDesignStyleKey.MaterialDesignBody1Hyperlink}}">
    <Setter Property="FontFamily" Value="OpenSansSemibold" />
    <Setter Property="FontSize" Value="20" />
  </Style>

  <Style x:Key="{x:Static choreoApp:MaterialDesignStyleKey.MaterialDesignHeadline5Hyperlink}"
         TargetType="Label"
         BasedOn="{StaticResource {x:Static choreoApp:MaterialDesignStyleKey.MaterialDesignBody1Hyperlink}}">
    <Setter Property="FontSize" Value="24" />
  </Style>

  <Style x:Key="{x:Static choreoApp:MaterialDesignStyleKey.MaterialDesignHeadline4Hyperlink}"
         TargetType="Label"
         BasedOn="{StaticResource {x:Static choreoApp:MaterialDesignStyleKey.MaterialDesignBody1Hyperlink}}">
    <Setter Property="FontSize" Value="34" />
  </Style>

  <Style x:Key="{x:Static choreoApp:MaterialDesignStyleKey.MaterialDesignHeadline3Hyperlink}"
         TargetType="Label"
         BasedOn="{StaticResource {x:Static choreoApp:MaterialDesignStyleKey.MaterialDesignBody1Hyperlink}}">
    <Setter Property="FontSize" Value="48" />
  </Style>

  <Style x:Key="{x:Static choreoApp:MaterialDesignStyleKey.MaterialDesignHeadline2Hyperlink}"
         TargetType="Label"
         BasedOn="{StaticResource {x:Static choreoApp:MaterialDesignStyleKey.MaterialDesignBody1Hyperlink}}">
    <Setter Property="FontSize" Value="60" />
  </Style>

  <Style x:Key="{x:Static choreoApp:MaterialDesignStyleKey.MaterialDesignHeadline1Hyperlink}"
         TargetType="Label"
         BasedOn="{StaticResource {x:Static choreoApp:MaterialDesignStyleKey.MaterialDesignBody1Hyperlink}}">
    <Setter Property="FontSize" Value="96" />
  </Style>

</ResourceDictionary>
