                <ResourceDictionary Source="Resources/Styles/MaterialDesign3.Entry.xaml" />
                <ResourceDictionary Source="Resources/Styles/MaterialDesign3.SearchBar.xaml" />
                <ResourceDictionary Source="Resources/Styles/MaterialDesign3.Shadows.xaml" />
                <ResourceDictionary Source="Resources/Styles/MaterialDesign3.Slider.xaml" />
                <ResourceDictionary Source="Resources/Styles/MaterialDesign3.Switch.xaml" />
                <ResourceDictionary Source="Resources/Styles/MaterialDesign3.ToggleButton.xaml" />
                <ResourceDictionary Source="Resources/Styles/MaterialDesign3.Typography.xaml" />
                <ResourceDictionary Source="Resources/Styles/MaterialDesign3.PackIcon.xaml" />
