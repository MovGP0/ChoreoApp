<?xml version="1.0" encoding="utf-8" ?>
<maui:ReactiveContentPage x:TypeArguments="settings:SettingsViewModel"
                          xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                          xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                          xmlns:maui="using:ReactiveUI.Maui"
                          xmlns:choreoApp="using:ChoreoApp"
                          xmlns:settings="clr-namespace:ChoreoApp.Settings"
                          xmlns:i18n="clr-namespace:ChoreoApp.i18n;assembly=ChoreoApp.i18n"
                          x:Class="ChoreoApp.Settings.SettingsPage">
    <ScrollView x:DataType="settings:SettingsViewModel">
        <VerticalStackLayout Padding="24"
                             Spacing="16">
            <Label Text="{x:Static i18n:Translations.SettingsTitle}"
                   FontSize="26"
                   FontAttributes="Bold" />
            <Grid ColumnDefinitions="*,Auto"
                  RowDefinitions="Auto"
                  ColumnSpacing="12"
                  RowSpacing="0">
                <Label Text="{x:Static i18n:Translations.DarkModeLabel}"
                       Grid.Column="0"
                       VerticalOptions="Center"
                       SemanticProperties.Description="{x:Static i18n:Translations.DarkModeLabel}" />
                <Switch Grid.Column="1"
                        VerticalOptions="Center"
                        Style="{StaticResource MaterialDesign3ToggleSwitchStyle}"
                        IsToggled="{Binding IsDarkMode, Mode=TwoWay}" />
            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</maui:ReactiveContentPage>
