<?xml version="1.0" encoding="utf-8" ?>
<maui:ReactiveContentView x:TypeArguments="settings:ChoreographySettingsViewModel"
                          x:Name="Root"
                          xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                          xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                          xmlns:maui="using:ReactiveUI.Maui"
                          xmlns:styling="clr-namespace:MaterialDesignThemes.Maui;assembly=MaterialDesignThemes.Maui"
                          xmlns:settings="clr-namespace:ChoreoApp.ChoreographySettings"
                          xmlns:i18n="clr-namespace:ChoreoApp.i18n;assembly=ChoreoApp.i18n"
                          xmlns:colorPicker="clr-namespace:ChoreoApp.ColorPicker"
                          xmlns:conv="clr-namespace:ChoreoApp.ChoreographySettings.Converters"
                          BackgroundColor="{DynamicResource Key={x:Static styling:MaterialDesignColorKey.SurfaceVariant}}"
                          x:DataType="settings:ChoreographySettingsViewModel"
                          x:Class="ChoreoApp.ChoreographySettings.ChoreographySettingsView">
    <maui:ReactiveContentView.Resources>
        <ResourceDictionary>
            <conv:DecimalDoubleConverter x:Key="DecimalDoubleConverter" />
            <Style x:Key="SceneTimestampNumericUpDownEntryStyle"
                   TargetType="Entry"
                   BasedOn="{StaticResource MaterialDesignEntry}">
                <Setter Property="BackgroundColor"
                        Value="{DynamicResource Key={x:Static styling:MaterialDesignColorKey.SurfaceVariant}}" />
                <Setter Property="TextColor"
                        Value="{DynamicResource Key={x:Static styling:MaterialDesignColorKey.OnSurface}}" />
                <Setter Property="PlaceholderColor"
                        Value="{DynamicResource Key={x:Static styling:MaterialDesignColorKey.OnSurfaceVariant}}" />
            </Style>
            <Style x:Key="SceneTimestampNumericUpDownStyle"
                   TargetType="styling:NumericUpDown"
                   BasedOn="{StaticResource MaterialDesignNumericUpDown}">
                <Setter Property="BackgroundColor"
                        Value="{DynamicResource Key={x:Static styling:MaterialDesignColorKey.SurfaceVariant}}" />
                <Setter Property="EntryStyle"
                        Value="{StaticResource SceneTimestampNumericUpDownEntryStyle}" />
                <Setter Property="IconForeground"
                        Value="{DynamicResource Key={x:Static styling:MaterialDesignColorKey.OnSurfaceVariant}}" />
            </Style>
        </ResourceDictionary>
    </maui:ReactiveContentView.Resources>
    <ScrollView>
        <VerticalStackLayout Spacing="4"
                             Padding="4">
            <styling:Card Padding="4" Style="{StaticResource MaterialDesignElevatedCard}">
                <VerticalStackLayout Spacing="12"
                                     IsEnabled="{Binding HasSelectedScene}">
                    <Label Text="{x:Static i18n:Translations.SceneSectionTitle}"
                           FontAttributes="Bold"
                           FontSize="18"
                           TextColor="{DynamicResource Key={x:Static styling:MaterialDesignColorKey.OnSurface}}" />
                    <Entry Placeholder="{x:Static i18n:Translations.SceneNameLabel}"
                           Text="{Binding SceneName}"
                           TextColor="{DynamicResource Key={x:Static styling:MaterialDesignColorKey.OnSurface}}"
                           BackgroundColor="{DynamicResource Key={x:Static styling:MaterialDesignColorKey.SurfaceVariant}}"
                           PlaceholderColor="{DynamicResource Key={x:Static styling:MaterialDesignColorKey.OnSurfaceVariant}}" />
                    <Editor Placeholder="{x:Static i18n:Translations.SceneTextLabel}"
                            Text="{Binding SceneText}"
                            AutoSize="TextChanges"
                            TextColor="{DynamicResource Key={x:Static styling:MaterialDesignColorKey.OnSurface}}"
                            BackgroundColor="{DynamicResource Key={x:Static styling:MaterialDesignColorKey.SurfaceVariant}}"
                            PlaceholderColor="{DynamicResource Key={x:Static styling:MaterialDesignColorKey.OnSurfaceVariant}}" />
                    <Grid ColumnDefinitions="*,Auto"
                          RowDefinitions="Auto"
                          ColumnSpacing="12"
                          RowSpacing="8">
                        <Label Text="{x:Static i18n:Translations.SceneFixedPositionsLabel}"
                               Grid.Column="0"
                               TextColor="{DynamicResource Key={x:Static styling:MaterialDesignColorKey.OnSurfaceVariant}}" />
                        <CheckBox Grid.Column="1"
                                  IsChecked="{Binding SceneFixedPositions}"
                                  VerticalOptions="Center" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto"
                          RowDefinitions="Auto,Auto"
                          ColumnSpacing="12"
                          RowSpacing="8">
                        <Label Text="{x:Static i18n:Translations.SceneTimestampLabel}"
                               Grid.Column="0"
                               Grid.Row="0"
                               VerticalOptions="Center"
                               TextColor="{DynamicResource Key={x:Static styling:MaterialDesignColorKey.OnSurfaceVariant}}" />
                        <CheckBox Grid.Column="1"
                                  Grid.Row="0"
                                  IsChecked="{Binding SceneHasTimestamp}"
                                  VerticalOptions="Center" />
                        <Grid Grid.Column="0"
                              Grid.Row="1"
                              Grid.ColumnSpan="2"
                              ColumnDefinitions="Auto,*"
                              RowDefinitions="Auto,Auto,Auto"
                              ColumnSpacing="12"
                              RowSpacing="4">
                          <!-- Minutes -->
                          <Label Text="{x:Static i18n:Translations.SceneTimestampMinutesLabel}"
                                 Grid.Row="0"
                                 Grid.Column="0"
                                 VerticalOptions="Center"
                                 TextColor="{DynamicResource Key={x:Static styling:MaterialDesignColorKey.OnSurfaceVariant}}" />
                            <styling:NumericUpDown Grid.Row="0"
                                                   Grid.Column="1"
                                                   Style="{StaticResource SceneTimestampNumericUpDownStyle}"
                                                   Minimum="0"
                                                   Maximum="1440"
                                                   ValueStep="1"
                                                   VerticalOptions="Center"
                                                   Value="{Binding SceneTimestampMinutes}"
                                                   IsEnabled="{Binding SceneHasTimestamp}" />
                            <!-- Seconds -->
                            <Label Text="{x:Static i18n:Translations.SceneTimestampSecondsLabel}"
                                   Grid.Row="1"
                                   Grid.Column="0"
                                   VerticalOptions="Center"
                                   TextColor="{DynamicResource Key={x:Static styling:MaterialDesignColorKey.OnSurfaceVariant}}" />
                            <styling:NumericUpDown Grid.Row="1"
                                                   Grid.Column="1"
                                                   Style="{StaticResource SceneTimestampNumericUpDownStyle}"
                                                   Minimum="0"
                                                   Maximum="59"
                                                   ValueStep="1"
                                                   VerticalOptions="Center"
                                                   Value="{Binding SceneTimestampSeconds}"
                                                   IsEnabled="{Binding SceneHasTimestamp}" />
                            <!-- Milliseconds -->
                            <Label Text="{x:Static i18n:Translations.SceneTimestampMillisecondsLabel}"
                                   Grid.Row="2"
                                   Grid.Column="0"
                                   VerticalOptions="Center"
                                   TextColor="{DynamicResource Key={x:Static styling:MaterialDesignColorKey.OnSurfaceVariant}}" />
                            <styling:NumericUpDown Grid.Row="2"
                                                   Grid.Column="1"
                                                   Style="{StaticResource SceneTimestampNumericUpDownStyle}"
                                                   Minimum="0"
                                                   Maximum="999"
                                                   ValueStep="10"
                                                   VerticalOptions="Center"
                                                   Value="{Binding SceneTimestampMilliseconds}"
                                                   IsEnabled="{Binding SceneHasTimestamp}" />
                        </Grid>
                    </Grid>
                    <Label Text="{x:Static i18n:Translations.SceneColorLabel}"
                           TextColor="{DynamicResource Key={x:Static styling:MaterialDesignColorKey.OnSurfaceVariant}}" />
                    <colorPicker:MaterialColorDropdown ItemsSource="{Binding ColorGroups}"
                                                        SelectedColor="{Binding SceneColor}" />
                </VerticalStackLayout>
            </styling:Card>
            <styling:Card Padding="4" Style="{StaticResource MaterialDesignElevatedCard}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="{x:Static i18n:Translations.ChoreographySectionTitle}"
                           FontAttributes="Bold"
                           FontSize="18"
                           TextColor="{DynamicResource Key={x:Static styling:MaterialDesignColorKey.OnSurface}}" />
                    <Entry Placeholder="{x:Static i18n:Translations.ChoreographyCommentPlaceholder}"
                           Text="{Binding Comment}"
                           TextColor="{DynamicResource Key={x:Static styling:MaterialDesignColorKey.OnSurface}}"
                           BackgroundColor="{DynamicResource Key={x:Static styling:MaterialDesignColorKey.SurfaceVariant}}"
                           PlaceholderColor="{DynamicResource Key={x:Static styling:MaterialDesignColorKey.OnSurfaceVariant}}" />
                    <Entry Placeholder="{x:Static i18n:Translations.ChoreographyNamePlaceholder}"
                           Text="{Binding Name}"
                           TextColor="{DynamicResource Key={x:Static styling:MaterialDesignColorKey.OnSurface}}"
                           BackgroundColor="{DynamicResource Key={x:Static styling:MaterialDesignColorKey.SurfaceVariant}}"
                           PlaceholderColor="{DynamicResource Key={x:Static styling:MaterialDesignColorKey.OnSurfaceVariant}}" />
                    <Entry Placeholder="{x:Static i18n:Translations.ChoreographySubtitlePlaceholder}"
                           Text="{Binding Subtitle}"
                           TextColor="{DynamicResource Key={x:Static styling:MaterialDesignColorKey.OnSurface}}"
                           BackgroundColor="{DynamicResource Key={x:Static styling:MaterialDesignColorKey.SurfaceVariant}}"
                           PlaceholderColor="{DynamicResource Key={x:Static styling:MaterialDesignColorKey.OnSurfaceVariant}}" />
                    <DatePicker Date="{Binding Date}"
                                TextColor="{DynamicResource Key={x:Static styling:MaterialDesignColorKey.OnSurface}}"
                                BackgroundColor="{DynamicResource Key={x:Static styling:MaterialDesignColorKey.SurfaceVariant}}" />
                    <Entry Placeholder="{x:Static i18n:Translations.ChoreographyVariationPlaceholder}"
                           Text="{Binding Variation}"
                           TextColor="{DynamicResource Key={x:Static styling:MaterialDesignColorKey.OnSurface}}"
                           BackgroundColor="{DynamicResource Key={x:Static styling:MaterialDesignColorKey.SurfaceVariant}}"
                           PlaceholderColor="{DynamicResource Key={x:Static styling:MaterialDesignColorKey.OnSurfaceVariant}}" />
                    <Entry Placeholder="{x:Static i18n:Translations.ChoreographyAuthorPlaceholder}"
                           Text="{Binding Author}"
                           TextColor="{DynamicResource Key={x:Static styling:MaterialDesignColorKey.OnSurface}}"
                           BackgroundColor="{DynamicResource Key={x:Static styling:MaterialDesignColorKey.SurfaceVariant}}"
                           PlaceholderColor="{DynamicResource Key={x:Static styling:MaterialDesignColorKey.OnSurfaceVariant}}" />
                    <Editor Placeholder="{x:Static i18n:Translations.ChoreographyDescriptionPlaceholder}"
                            Text="{Binding Description}"
                            AutoSize="TextChanges"
                            TextColor="{DynamicResource Key={x:Static styling:MaterialDesignColorKey.OnSurface}}"
                            BackgroundColor="{DynamicResource Key={x:Static styling:MaterialDesignColorKey.SurfaceVariant}}"
                            PlaceholderColor="{DynamicResource Key={x:Static styling:MaterialDesignColorKey.OnSurfaceVariant}}" />
                </VerticalStackLayout>
            </styling:Card>

            <styling:Card Padding="4" Style="{StaticResource MaterialDesignElevatedCard}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="{x:Static i18n:Translations.ChoreographyFloorTitle}"
                           FontAttributes="Bold"
                           FontSize="18"
                           TextColor="{DynamicResource Key={x:Static styling:MaterialDesignColorKey.OnSurface}}" />
                    <Grid ColumnDefinitions="*,*"
                          RowDefinitions="Auto,Auto,Auto,Auto"
                          ColumnSpacing="12"
                          RowSpacing="8">
                        <Label Text="{x:Static i18n:Translations.ChoreographyFloorFrontLabel}"
                               Grid.Row="0"
                               Grid.Column="0"
                               TextColor="{DynamicResource Key={x:Static styling:MaterialDesignColorKey.OnSurfaceVariant}}" />
                        <Picker Grid.Row="0"
                                Grid.Column="1"
                                ItemsSource="{Binding FloorSizeOptions}"
                                SelectedItem="{Binding FloorFront}"
                                ItemDisplayBinding="{Binding .}"
                                TextColor="{DynamicResource Key={x:Static styling:MaterialDesignColorKey.OnSurface}}"
                                BackgroundColor="{DynamicResource Key={x:Static styling:MaterialDesignColorKey.SurfaceVariant}}" />

                        <Label Text="{x:Static i18n:Translations.ChoreographyFloorBackLabel}"
                               Grid.Row="1"
                               Grid.Column="0"
                               TextColor="{DynamicResource Key={x:Static styling:MaterialDesignColorKey.OnSurfaceVariant}}" />
                        <Picker Grid.Row="1"
                                Grid.Column="1"
                                ItemsSource="{Binding FloorSizeOptions}"
                                SelectedItem="{Binding FloorBack}"
                                ItemDisplayBinding="{Binding .}"
                                TextColor="{DynamicResource Key={x:Static styling:MaterialDesignColorKey.OnSurface}}"
                                BackgroundColor="{DynamicResource Key={x:Static styling:MaterialDesignColorKey.SurfaceVariant}}" />

                        <Label Text="{x:Static i18n:Translations.ChoreographyFloorLeftLabel}"
                               Grid.Row="2"
                               Grid.Column="0"
                               TextColor="{DynamicResource Key={x:Static styling:MaterialDesignColorKey.OnSurfaceVariant}}" />
                        <Picker Grid.Row="2"
                                Grid.Column="1"
                                ItemsSource="{Binding FloorSizeOptions}"
                                SelectedItem="{Binding FloorLeft}"
                                ItemDisplayBinding="{Binding .}"
                                TextColor="{DynamicResource Key={x:Static styling:MaterialDesignColorKey.OnSurface}}"
                                BackgroundColor="{DynamicResource Key={x:Static styling:MaterialDesignColorKey.SurfaceVariant}}" />

                        <Label Text="{x:Static i18n:Translations.ChoreographyFloorRightLabel}"
                               Grid.Row="3"
                               Grid.Column="0"
                               TextColor="{DynamicResource Key={x:Static styling:MaterialDesignColorKey.OnSurfaceVariant}}" />
                        <Picker Grid.Row="3"
                                Grid.Column="1"
                                ItemsSource="{Binding FloorSizeOptions}"
                                SelectedItem="{Binding FloorRight}"
                                ItemDisplayBinding="{Binding .}"
                                TextColor="{DynamicResource Key={x:Static styling:MaterialDesignColorKey.OnSurface}}"
                                BackgroundColor="{DynamicResource Key={x:Static styling:MaterialDesignColorKey.SurfaceVariant}}" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto"
                          RowDefinitions="Auto"
                          ColumnSpacing="12"
                          RowSpacing="8">
                        <Label Text="{x:Static i18n:Translations.ChoreographyGridSizeLabel}"
                               Grid.Column="0"
                               TextColor="{DynamicResource Key={x:Static styling:MaterialDesignColorKey.OnSurfaceVariant}}" />
                        <Picker Grid.Column="1"
                                ItemsSource="{Binding GridSizeOptions}"
                                SelectedItem="{Binding SelectedGridSizeOption}"
                                ItemDisplayBinding="{Binding Display}"
                                TextColor="{DynamicResource Key={x:Static styling:MaterialDesignColorKey.OnSurface}}"
                                BackgroundColor="{DynamicResource Key={x:Static styling:MaterialDesignColorKey.SurfaceVariant}}" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto"
                          RowDefinitions="Auto"
                          ColumnSpacing="12"
                          RowSpacing="8">
                        <Label Text="{x:Static i18n:Translations.ChoreographyGridLinesLabel}"
                               Grid.Column="0"
                               TextColor="{DynamicResource Key={x:Static styling:MaterialDesignColorKey.OnSurfaceVariant}}" />
                        <CheckBox Grid.Column="1"
                                  IsChecked="{Binding GridLines}"
                                  VerticalOptions="Center" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto"
                          RowDefinitions="Auto"
                          ColumnSpacing="12"
                          RowSpacing="8">
                        <Label Text="{x:Static i18n:Translations.ChoreographyTransparencyLabel}"
                               Grid.Column="0"
                               TextColor="{DynamicResource Key={x:Static styling:MaterialDesignColorKey.OnSurfaceVariant}}" />
                        <HorizontalStackLayout Grid.Column="1"
                                               Spacing="8"
                                               VerticalOptions="Center">
                            <Label Text="{Binding Transparency, StringFormat='{0:F2}'}"
                                   TextColor="{DynamicResource Key={x:Static styling:MaterialDesignColorKey.OnSurface}}" />
                            <Slider Minimum="0"
                                    Maximum="1"
                                    Value="{Binding Transparency, Converter={StaticResource DecimalDoubleConverter}}"
                                    WidthRequest="140" />
                        </HorizontalStackLayout>
                    </Grid>
                    <Label Text="{x:Static i18n:Translations.ChoreographyFloorColorLabel}"
                           TextColor="{DynamicResource Key={x:Static styling:MaterialDesignColorKey.OnSurfaceVariant}}" />
                    <colorPicker:MaterialColorDropdown ItemsSource="{Binding ColorGroups}"
                                                        SelectedColor="{Binding FloorColor}" />
                </VerticalStackLayout>
            </styling:Card>

            <styling:Card Padding="4" Style="{StaticResource MaterialDesignElevatedCard}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="{x:Static i18n:Translations.ChoreographyDisplayTitle}"
                           FontAttributes="Bold"
                           FontSize="18"
                           TextColor="{DynamicResource Key={x:Static styling:MaterialDesignColorKey.OnSurface}}" />
                    <Grid ColumnDefinitions="*,Auto"
                          RowDefinitions="Auto,Auto,Auto,Auto"
                          ColumnSpacing="12"
                          RowSpacing="8">
                        <Label Text="{x:Static i18n:Translations.ChoreographyDrawPathFromLabel}"
                               Grid.Row="0"
                               Grid.Column="0"
                               TextColor="{DynamicResource Key={x:Static styling:MaterialDesignColorKey.OnSurfaceVariant}}" />
                        <CheckBox Grid.Row="0"
                                  Grid.Column="1"
                                  IsChecked="{Binding DrawPathFrom}"
                                  VerticalOptions="Center" />

                        <Label Text="{x:Static i18n:Translations.ChoreographyDrawPathToLabel}"
                               Grid.Row="1"
                               Grid.Column="0"
                               TextColor="{DynamicResource Key={x:Static styling:MaterialDesignColorKey.OnSurfaceVariant}}" />
                        <CheckBox Grid.Row="1"
                                  Grid.Column="1"
                                  IsChecked="{Binding DrawPathTo}"
                                  VerticalOptions="Center" />

                        <Label Text="{x:Static i18n:Translations.ChoreographyShowTimestampsLabel}"
                               Grid.Row="2"
                               Grid.Column="0"
                               TextColor="{DynamicResource Key={x:Static styling:MaterialDesignColorKey.OnSurfaceVariant}}" />
                        <CheckBox Grid.Row="2"
                                  Grid.Column="1"
                                  IsChecked="{Binding ShowTimestamps}"
                                  VerticalOptions="Center" />

                        <Label Text="{x:Static i18n:Translations.ChoreographyPositionsAtSideLabel}"
                               Grid.Row="3"
                               Grid.Column="0"
                               TextColor="{DynamicResource Key={x:Static styling:MaterialDesignColorKey.OnSurfaceVariant}}" />
                        <CheckBox Grid.Row="3"
                                  Grid.Column="1"
                                  IsChecked="{Binding PositionsAtSide}"
                                  VerticalOptions="Center" />
                    </Grid>
                </VerticalStackLayout>
            </styling:Card>
        </VerticalStackLayout>
    </ScrollView>
</maui:ReactiveContentView>
