<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:styling="clr-namespace:ChoreoApp.Styling;assembly=ChoreoApp.Styling">

    <Style TargetType="styling:SliderWithTicks">
        <Setter Property="MinimumTrackColor" Value="{DynamicResource Key={x:Static styling:MaterialDesignColorKey.Primary}}" />
        <Setter Property="MaximumTrackColor" Value="{DynamicResource Key={x:Static styling:MaterialDesignColorKey.SurfaceVariant}}" />
        <Setter Property="ThumbColor" Value="{DynamicResource Key={x:Static styling:MaterialDesignColorKey.Primary}}" />
        <Setter Property="TickColor" Value="{DynamicResource Key={x:Static styling:MaterialDesignColorKey.OnSurfaceVariant}}" />
        <Setter Property="Padding" Value="0" />
    </Style>

</ResourceDictionary>
