<?xml version="1.0" encoding="utf-8" ?>
<maui:ReactiveContentPage x:TypeArguments="home:HomeViewModel"
                          xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                          xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                          xmlns:maui="using:ReactiveUI.Maui"
                          xmlns:styling="clr-namespace:MaterialDesignThemes.Maui;assembly=MaterialDesignThemes.Maui"
                          xmlns:home="clr-namespace:MaterialDesignDemo.Maui.Home"
                          x:Class="MaterialDesignDemo.Maui.Home.HomePage"
                          x:DataType="home:HomeViewModel">
  <maui:ReactiveContentPage.Resources>
    <ResourceDictionary>
      <Style x:Key="HomeIconTextButton"
             TargetType="styling:ContentButton"
             BasedOn="{StaticResource MaterialDesignFlatButton}">
        <Setter Property="Padding" Value="6,2" />
        <Setter Property="HeightRequest" Value="30" />
        <Setter Property="MinimumHeightRequest" Value="30" />
      </Style>
      <Style x:Key="HomeCircleIconButton"
             TargetType="styling:ContentButton"
             BasedOn="{StaticResource MaterialDesignIconButton}">
        <Setter Property="WidthRequest" Value="40" />
        <Setter Property="HeightRequest" Value="40" />
        <Setter Property="MinimumWidthRequest" Value="40" />
        <Setter Property="MinimumHeightRequest" Value="40" />
        <Setter Property="CornerRadius" Value="20" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="VerticalOptions" Value="Center" />
      </Style>
      <Style x:Key="HomeFabButton"
             TargetType="styling:ContentButton"
             BasedOn="{StaticResource MaterialDesignFloatingActionButton}">
        <Setter Property="WidthRequest" Value="56" />
        <Setter Property="HeightRequest" Value="56" />
        <Setter Property="MinimumWidthRequest" Value="56" />
        <Setter Property="MinimumHeightRequest" Value="56" />
        <Setter Property="CornerRadius" Value="28" />
        <Setter Property="Padding" Value="0" />
      </Style>
    </ResourceDictionary>
  </maui:ReactiveContentPage.Resources>
  <Grid RowDefinitions="Auto,*">
    <Grid Margin="16"
          HorizontalOptions="Center"
          VerticalOptions="Start"
          ColumnDefinitions="Auto,*">
      <Image WidthRequest="100"
             HeightRequest="100"
             Source="ms_icon_310x310.png"
             Aspect="AspectFit"
             SemanticProperties.Description="Material Design logo" />

      <VerticalStackLayout Grid.Column="1"
                           Margin="24,0,0,0"
                           VerticalOptions="Center"
                           Spacing="8">
        <Label Style="{StaticResource MaterialDesignHeadlineMediumTextBlock}"
               Text="Welcome to Material Design In XAML Toolkit"
               LineBreakMode="WordWrap"
               SemanticProperties.HeadingLevel="Level1" />

        <styling:ContentButton Style="{StaticResource MaterialDesignFlatButton}"
                               Command="{Binding OpenExploreCommand}"
                               HorizontalOptions="Center"
                               Padding="16,8"
                               HeightRequest="40"
                               MinimumHeightRequest="40">
          <HorizontalStackLayout Spacing="8">
            <styling:PackIcon WidthRequest="20" HeightRequest="20" Kind="Binoculars" />
            <Label Text="EXPLORE" VerticalOptions="Center" FontSize="14" />
          </HorizontalStackLayout>
        </styling:ContentButton>
      </VerticalStackLayout>
    </Grid>

    <Grid Grid.Row="1">
      <ScrollView Margin="0,0,0,32"
                  HorizontalOptions="Center"
                  VerticalOptions="End"
                  Orientation="Horizontal"
                  HorizontalScrollBarVisibility="Always"
                  VerticalScrollBarVisibility="Never">
        <HorizontalStackLayout Spacing="8">
          <styling:Card WidthRequest="420"
                        HeightRequest="270"
                        Margin="4,2,8,16"
                        Style="{StaticResource MaterialDesignElevatedCard}">
            <Grid RowDefinitions="Auto,*,Auto,Auto"
                  ColumnDefinitions="200,*">
              <Image Grid.RowSpan="4"
                     Source="contact.png"
                     Aspect="AspectFill" />

              <Label Grid.Column="1"
                     Margin="16,16,16,2"
                     Style="{StaticResource MaterialDesignHeadlineSmallTextBlock}"
                     Text="Get In Touch" />

              <Label Grid.Row="1"
                     Grid.Column="1"
                     Margin="16,0,16,8"
                     Text="Say hello, make a feature request, or raise a bug through one of these channels:"
                     TextColor="{DynamicResource Key={x:Static styling:MaterialDesignColorKey.OnSurfaceVariant}}"
                     LineBreakMode="WordWrap" />

              <Border Grid.Row="2"
                      Grid.Column="1"
                      Margin="0,8,0,0"
                      Stroke="{DynamicResource Key={x:Static styling:MaterialDesignColorKey.OutlineVariant}}"
                      StrokeThickness="1">
                <Grid Margin="8" ColumnDefinitions="*,*">
                  <styling:ContentButton Grid.Column="0"
                                         Style="{StaticResource HomeIconTextButton}"
                                         Command="{Binding OpenGitHubCommand}"
                                         HorizontalOptions="Start">
                    <HorizontalStackLayout Spacing="8">
                      <styling:PackIcon WidthRequest="14" HeightRequest="14" Kind="Github" />
                      <Label Text="GitHub" VerticalOptions="Center" FontSize="12" />
                    </HorizontalStackLayout>
                  </styling:ContentButton>

                  <styling:ContentButton Grid.Column="1"
                                         Style="{StaticResource HomeIconTextButton}"
                                         Command="{Binding OpenTwitterCommand}"
                                         HorizontalOptions="End">
                    <HorizontalStackLayout Spacing="8">
                      <styling:PackIcon WidthRequest="14" HeightRequest="14" Kind="Twitter" />
                      <Label Text="Twitter" VerticalOptions="Center" FontSize="12" />
                    </HorizontalStackLayout>
                  </styling:ContentButton>
                </Grid>
              </Border>

              <Border Grid.Row="3"
                      Grid.Column="1"
                      Stroke="{DynamicResource Key={x:Static styling:MaterialDesignColorKey.OutlineVariant}}"
                      StrokeThickness="1">
                <Grid Margin="8" ColumnDefinitions="*,*">
                  <styling:ContentButton Grid.Column="0"
                                         Style="{StaticResource HomeIconTextButton}"
                                         Command="{Binding OpenChatCommand}"
                                         HorizontalOptions="Start">
                    <HorizontalStackLayout Spacing="8">
                      <styling:PackIcon WidthRequest="14" HeightRequest="14" Kind="Message" />
                      <Label Text="Chat" VerticalOptions="Center" FontSize="12" />
                    </HorizontalStackLayout>
                  </styling:ContentButton>

                  <styling:ContentButton Grid.Column="1"
                                         Style="{StaticResource HomeIconTextButton}"
                                         Command="{Binding OpenEmailCommand}"
                                         HorizontalOptions="End">
                    <HorizontalStackLayout Spacing="8">
                      <styling:PackIcon WidthRequest="14" HeightRequest="14" Kind="Email" />
                      <Label Text="Email" VerticalOptions="Center" FontSize="12" />
                    </HorizontalStackLayout>
                  </styling:ContentButton>
                </Grid>
              </Border>
            </Grid>
          </styling:Card>

          <styling:Card WidthRequest="420"
                        HeightRequest="270"
                        Margin="8,2,4,16"
                        Style="{StaticResource MaterialDesignElevatedCard}">
            <Grid RowDefinitions="Auto,Auto"
                  ColumnDefinitions="260,*">

              <styling:PackIcon WidthRequest="260"
                                HeightRequest="260"
                                Width="260"
                                Height="260"
                                HorizontalOptions="Center"
                                VerticalOptions="Center"
                                Kind="Github" />

              <VerticalStackLayout Grid.Column="1">
                <Label Margin="16,16,16,8"
                       Style="{StaticResource MaterialDesignHeadlineSmallTextBlock}"
                       Text="Open Source" />

                <Label Margin="16,0,16,8"
                       FontSize="12"
                       Text="This project is completely open source. If you like it and want to say thanks you could hit the GitHub Star button, tweet or post about it, or tell your mum about it!"
                       TextColor="{DynamicResource Key={x:Static styling:MaterialDesignColorKey.OnSurfaceVariant}}"
                       LineBreakMode="WordWrap" />
              </VerticalStackLayout>

              <Border Grid.Row="1"
                      Grid.ColumnSpan="2"
                      Padding="8,4"
                      Stroke="{DynamicResource Key={x:Static styling:MaterialDesignColorKey.OutlineVariant}}"
                      StrokeThickness="1">
                <Grid ColumnDefinitions="*,Auto">
                  <Label Grid.Column="0"
                         Margin="12,4,8,4"
                         VerticalOptions="Center"
                         FontSize="12"
                         Text="Feel like you want to make a donation? It would be gratefully received. Click the button to donate via Open Collective."
                         TextColor="{DynamicResource Key={x:Static styling:MaterialDesignColorKey.OnSurfaceVariant}}"
                         LineBreakMode="WordWrap" />

                  <styling:ContentButton Grid.Column="1"
                                         Style="{StaticResource MaterialDesignFlatButton}"
                                         Command="{Binding OpenDonateCommand}"
                                         VerticalOptions="Center">
                    <HorizontalStackLayout Spacing="8">
                      <styling:PackIcon WidthRequest="16" HeightRequest="16" Kind="Gift" />
                      <Label Text="Donate" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                  </styling:ContentButton>
                </Grid>
              </Border>
            </Grid>
          </styling:Card>
        </HorizontalStackLayout>
      </ScrollView>

      <styling:PopupBox Margin="32"
                        HorizontalOptions="End"
                        VerticalOptions="End"
                        Style="{StaticResource MaterialDesignPopupBox}"
                        ToggleContentTemplate="{x:Null}">
        <styling:PopupBox.ToggleContent>
          <Border WidthRequest="56"
                  HeightRequest="56"
                  BackgroundColor="{DynamicResource Key={x:Static styling:MaterialDesignColorKey.Primary}}">
            <Border.StrokeShape>
              <RoundRectangle CornerRadius="28" />
            </Border.StrokeShape>
            <styling:PackIcon WidthRequest="24"
                              HeightRequest="24"
                              Kind="Plus"
                              VerticalOptions="Center"
                              HorizontalOptions="Center"
                              ForegroundColor="{DynamicResource Key={x:Static styling:MaterialDesignColorKey.OnPrimary}}" />
          </Border>
        </styling:PopupBox.ToggleContent>
        <VerticalStackLayout Spacing="8">
          <styling:ContentButton Style="{StaticResource HomeCircleIconButton}"
                                 Command="{Binding OpenGitHubCommand}"
                                 ToolTipProperties.Text="GitHub"
                                 HorizontalOptions="Center">
            <styling:PackIcon WidthRequest="18" HeightRequest="18" Kind="Github" />
          </styling:ContentButton>

          <styling:ContentButton Style="{StaticResource HomeCircleIconButton}"
                                 BackgroundColor="{DynamicResource Key={x:Static styling:MaterialDesignColorKey.Primary}}"
                                 Foreground="{DynamicResource Key={x:Static styling:MaterialDesignColorKey.OnPrimary}}"
                                 Command="{Binding OpenTwitterCommand}"
                                 ToolTipProperties.Text="Twitter"
                                 HorizontalOptions="Center">
            <styling:PackIcon WidthRequest="18" HeightRequest="18" Kind="Twitter" />
          </styling:ContentButton>

          <styling:ContentButton Style="{StaticResource HomeCircleIconButton}"
                                 BackgroundColor="{DynamicResource Key={x:Static styling:MaterialDesignColorKey.Secondary}}"
                                 Foreground="{DynamicResource Key={x:Static styling:MaterialDesignColorKey.OnSecondary}}"
                                 Command="{Binding OpenChatCommand}"
                                 ToolTipProperties.Text="Chat"
                                 HorizontalOptions="Center">
            <styling:PackIcon WidthRequest="18" HeightRequest="18" Kind="Message" />
          </styling:ContentButton>

          <styling:ContentButton Style="{StaticResource HomeCircleIconButton}"
                                 BackgroundColor="{DynamicResource Key={x:Static styling:MaterialDesignColorKey.Tertiary}}"
                                 Foreground="{DynamicResource Key={x:Static styling:MaterialDesignColorKey.OnTertiary}}"
                                 Command="{Binding OpenEmailCommand}"
                                 ToolTipProperties.Text="Email"
                                 HorizontalOptions="Center">
            <styling:PackIcon WidthRequest="18" HeightRequest="18" Kind="Email" />
          </styling:ContentButton>

          <styling:ContentButton Style="{StaticResource HomeCircleIconButton}"
                                 BackgroundColor="{DynamicResource Key={x:Static styling:MaterialDesignColorKey.PrimaryContainer}}"
                                 Foreground="{DynamicResource Key={x:Static styling:MaterialDesignColorKey.OnPrimaryContainer}}"
                                 Command="{Binding OpenDonateCommand}"
                                 ToolTipProperties.Text="Donate"
                                 HorizontalOptions="Center">
            <styling:PackIcon WidthRequest="18" HeightRequest="18" Kind="Gift" />
          </styling:ContentButton>
        </VerticalStackLayout>
      </styling:PopupBox>
    </Grid>
  </Grid>
</maui:ReactiveContentPage>
