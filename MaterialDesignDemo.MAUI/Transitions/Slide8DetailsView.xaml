<?xml version="1.0" encoding="utf-8" ?>
<maui:ReactiveContentView x:TypeArguments="transitions:TransitionsDemoViewModel"
                          xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                          xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                          xmlns:maui="using:ReactiveUI.Maui"
                          xmlns:styling="clr-namespace:MaterialDesignThemes.Maui;assembly=MaterialDesignThemes.Maui"
                          xmlns:transitions="clr-namespace:MaterialDesignDemo.MAUI.Transitions"
                          x:Class="MaterialDesignDemo.MAUI.Transitions.Slide8DetailsView"
                          x:DataType="transitions:TransitionsDemoViewModel">
  <Grid Padding="32">
    <styling:Card Style="{StaticResource MaterialDesignElevatedCard}">
      <VerticalStackLayout Padding="24" Spacing="12">
        <Label Style="{StaticResource MaterialDesignHeadlineSmallTextBlock}" Text="Details" />
        <Label Text="Slide 8 placeholder (details)." LineBreakMode="WordWrap" />
      </VerticalStackLayout>
    </styling:Card>
  </Grid>
</maui:ReactiveContentView>
