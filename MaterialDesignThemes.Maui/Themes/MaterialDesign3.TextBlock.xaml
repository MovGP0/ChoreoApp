<?xml version="1.0" encoding="UTF-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    xmlns:styling="clr-namespace:MaterialDesignThemes.Maui;assembly=MaterialDesignThemes.Maui">

  <Style x:Key="MaterialDesignTextBlock"
         TargetType="Label">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontAttributes" Value="None" />
    <Setter Property="TextColor" Value="{DynamicResource Key={x:Static styling:MaterialDesignColorKey.OnSurface}}" />
  </Style>

  <Style x:Key="MaterialDesignCaptionTextBlock"
         TargetType="Label"
         BasedOn="{StaticResource MaterialDesignTextBlock}">
    <Setter Property="FontSize" Value="12" />
  </Style>

  <Style x:Key="MaterialDesignBody1TextBlock"
         TargetType="Label"
         BasedOn="{StaticResource MaterialDesignTextBlock}">
    <Setter Property="FontSize" Value="16" />
  </Style>

  <Style x:Key="MaterialDesignBody2TextBlock"
         TargetType="Label"
         BasedOn="{StaticResource MaterialDesignTextBlock}">
    <Setter Property="FontSize" Value="14" />
  </Style>

  <Style x:Key="MaterialDesignOverlineTextBlock"
         TargetType="Label"
         BasedOn="{StaticResource MaterialDesignTextBlock}">
    <Setter Property="FontSize" Value="10" />
  </Style>

  <Style x:Key="MaterialDesignSubtitle1TextBlock"
         TargetType="Label"
         BasedOn="{StaticResource MaterialDesignTextBlock}">
    <Setter Property="FontSize" Value="16" />
  </Style>

  <Style x:Key="MaterialDesignSubtitle2TextBlock"
         TargetType="Label"
         BasedOn="{StaticResource MaterialDesignTextBlock}">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontAttributes" Value="Bold" />
  </Style>

  <Style x:Key="MaterialDesignHeadline6TextBlock"
         TargetType="Label"
         BasedOn="{StaticResource MaterialDesignTextBlock}">
    <Setter Property="FontSize" Value="20" />
    <Setter Property="FontAttributes" Value="Bold" />
  </Style>

  <Style x:Key="MaterialDesignHeadline5TextBlock"
         TargetType="Label"
         BasedOn="{StaticResource MaterialDesignTextBlock}">
    <Setter Property="FontSize" Value="24" />
  </Style>

  <Style x:Key="MaterialDesignHeadline4TextBlock"
         TargetType="Label"
         BasedOn="{StaticResource MaterialDesignTextBlock}">
    <Setter Property="FontSize" Value="34" />
  </Style>

  <Style x:Key="MaterialDesignHeadline3TextBlock"
         TargetType="Label"
         BasedOn="{StaticResource MaterialDesignTextBlock}">
    <Setter Property="FontSize" Value="48" />
  </Style>

  <Style x:Key="MaterialDesignHeadline2TextBlock"
         TargetType="Label"
         BasedOn="{StaticResource MaterialDesignTextBlock}">
    <Setter Property="FontSize" Value="60" />
  </Style>

  <Style x:Key="MaterialDesignHeadline1TextBlock"
         TargetType="Label"
         BasedOn="{StaticResource MaterialDesignTextBlock}">
    <Setter Property="FontSize" Value="96" />
  </Style>

  <Style x:Key="MaterialDesignButtonTextBlock"
         TargetType="Label"
         BasedOn="{StaticResource MaterialDesignTextBlock}">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontAttributes" Value="Bold" />
  </Style>

  <Style TargetType="Label"
         BasedOn="{StaticResource MaterialDesignTextBlock}" />
</ResourceDictionary>
