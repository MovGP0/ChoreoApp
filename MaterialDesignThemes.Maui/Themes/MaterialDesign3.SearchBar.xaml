<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
  xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
  xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
  xmlns:styling="clr-namespace:MaterialDesignThemes.Maui;assembly=MaterialDesignThemes.Maui">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="MaterialDesign3.Label.xaml" />
  </ResourceDictionary.MergedDictionaries>

  <Style x:Key="MaterialDesignHelperSearchBar"
         TargetType="Label"
         BasedOn="{StaticResource MaterialDesignLabel}">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Opacity" Value="0.72" />
    <Setter Property="TextColor"
            Value="{DynamicResource Key={x:Static styling:MaterialDesignColorKey.OnSurfaceVariant}}" />
    <Setter Property="Margin" Value="12,4,12,0" />
  </Style>

  <Style x:Key="MaterialDesignCharacterCounterSearchBar"
         TargetType="Label"
         BasedOn="{StaticResource MaterialDesignLabel}">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Opacity" Value="0.56" />
    <Setter Property="HorizontalTextAlignment" Value="End" />
    <Setter Property="TextColor"
            Value="{DynamicResource Key={x:Static styling:MaterialDesignColorKey.OnSurfaceVariant}}" />
    <Setter Property="Margin" Value="12,4,12,0" />
  </Style>

  <Style x:Key="MaterialDesignSearchBarBase"
         TargetType="SearchBar">
    <Setter Property="TextColor"
            Value="{DynamicResource Key={x:Static styling:MaterialDesignColorKey.OnSurface}}" />
    <Setter Property="PlaceholderColor"
            Value="{DynamicResource Key={x:Static styling:MaterialDesignColorKey.OnSurfaceVariant}}" />
    <Setter Property="SearchIconColor"
            Value="{DynamicResource Key={x:Static styling:MaterialDesignColorKey.OnSurfaceVariant}}" />
    <Setter Property="CancelButtonColor"
            Value="{DynamicResource Key={x:Static styling:MaterialDesignColorKey.OnSurfaceVariant}}" />
    <Setter Property="BackgroundColor"
            Value="{DynamicResource Key={x:Static styling:MaterialDesignColorKey.SurfaceContainerLow}}" />
    <Setter Property="FontFamily" Value="OpenSansRegular" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="HeightRequest" Value="48" />
    <Setter Property="MinimumHeightRequest" Value="48" />
    <Setter Property="MinimumWidthRequest" Value="44" />
    <Setter Property="styling:TextFieldAssist.HasFilledTextField" Value="True" />
    <Setter Property="styling:TextFieldAssist.TextFieldCornerRadius" Value="12" />
    <Setter Property="styling:TextFieldAssist.UnderlineBrush"
            Value="{DynamicResource Key={x:Static styling:MaterialDesignColorKey.Primary}}" />
    <Setter Property="styling:HintAssist.Foreground"
            Value="{DynamicResource Key={x:Static styling:MaterialDesignColorKey.Primary}}" />
    <Setter Property="styling:HintAssist.HelperTextStyle"
            Value="{StaticResource MaterialDesignHelperSearchBar}" />
    <Setter Property="styling:TextFieldAssist.CharacterCounterStyle"
            Value="{StaticResource MaterialDesignCharacterCounterSearchBar}" />
    <Setter Property="styling:TextFieldAssist.CharacterCounterVisibility" Value="Visible" />
    <Setter Property="VisualStateManager.VisualStateGroups">
      <VisualStateGroupList>
        <VisualStateGroup x:Name="CommonStates">
          <VisualState x:Name="Normal" />
          <VisualState x:Name="Disabled">
            <VisualState.Setters>
              <Setter Property="TextColor"
                      Value="{DynamicResource Key={x:Static styling:MaterialDesignColorKey.OnSurfaceVariant}}" />
              <Setter Property="PlaceholderColor"
                      Value="{DynamicResource Key={x:Static styling:MaterialDesignColorKey.OnSurfaceVariant}}" />
              <Setter Property="SearchIconColor"
                      Value="{DynamicResource Key={x:Static styling:MaterialDesignColorKey.OnSurfaceVariant}}" />
              <Setter Property="CancelButtonColor"
                      Value="{DynamicResource Key={x:Static styling:MaterialDesignColorKey.OnSurfaceVariant}}" />
              <Setter Property="BackgroundColor"
                      Value="{DynamicResource Key={x:Static styling:MaterialDesignColorKey.SurfaceContainerLowest}}" />
              <Setter Property="Opacity" Value="0.6" />
            </VisualState.Setters>
          </VisualState>
        </VisualStateGroup>
        <VisualStateGroup x:Name="FocusStates">
          <VisualState x:Name="Focused">
            <VisualState.Setters>
              <Setter Property="BackgroundColor"
                      Value="{DynamicResource Key={x:Static styling:MaterialDesignColorKey.SurfaceContainerHigh}}" />
              <Setter Property="SearchIconColor"
                      Value="{DynamicResource Key={x:Static styling:MaterialDesignColorKey.Primary}}" />
              <Setter Property="CancelButtonColor"
                      Value="{DynamicResource Key={x:Static styling:MaterialDesignColorKey.Primary}}" />
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="Unfocused">
            <VisualState.Setters>
              <Setter Property="BackgroundColor"
                      Value="{DynamicResource Key={x:Static styling:MaterialDesignColorKey.SurfaceContainerLow}}" />
            </VisualState.Setters>
          </VisualState>
        </VisualStateGroup>
      </VisualStateGroupList>
    </Setter>
  </Style>

  <Style x:Key="MaterialDesignSearchBar"
         TargetType="SearchBar"
         BasedOn="{StaticResource MaterialDesignSearchBarBase}" />

  <Style x:Key="MaterialDesignFloatingHintSearchBar"
         TargetType="SearchBar"
         BasedOn="{StaticResource MaterialDesignSearchBar}">
    <Setter Property="styling:HintAssist.IsFloating" Value="True" />
  </Style>

  <Style x:Key="MaterialDesignFilledSearchBar"
         TargetType="SearchBar"
         BasedOn="{StaticResource MaterialDesignFloatingHintSearchBar}">
    <Setter Property="BackgroundColor"
            Value="{DynamicResource Key={x:Static styling:MaterialDesignColorKey.SurfaceContainerLow}}" />
    <Setter Property="styling:TextFieldAssist.HasFilledTextField" Value="True" />
    <Setter Property="styling:TextFieldAssist.TextFieldCornerRadius" Value="12" />
    <Setter Property="styling:TextFieldAssist.UnderlineCornerRadius" Value="0" />
  </Style>

  <Style x:Key="MaterialDesignOutlinedSearchBar"
         TargetType="SearchBar"
         BasedOn="{StaticResource MaterialDesignFloatingHintSearchBar}">
    <Setter Property="BackgroundColor"
            Value="{DynamicResource Key={x:Static styling:MaterialDesignColorKey.Surface}}" />
    <Setter Property="styling:TextFieldAssist.HasOutlinedTextField" Value="True" />
    <Setter Property="styling:TextFieldAssist.TextFieldCornerRadius" Value="12" />
    <Setter Property="styling:TextFieldAssist.OutlinedBorderActiveThickness" Value="1" />
  </Style>

  <Style TargetType="SearchBar"
         BasedOn="{StaticResource MaterialDesignSearchBar}" />
</ResourceDictionary>
