<?xml version="1.0" encoding="utf-8" ?>
<maui:ReactiveContentPage x:TypeArguments="splitButtons:SplitButtonsViewModel"
                          xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                          xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                          xmlns:maui="using:ReactiveUI.Maui"
                          xmlns:splitButtons="clr-namespace:MaterialDesignDemo.Maui.SplitButtons"
                          xmlns:styling="clr-namespace:MaterialDesignThemes.Maui;assembly=MaterialDesignThemes.Maui"
                          x:Class="MaterialDesignDemo.Maui.SplitButtons.SplitButtonsPage"
                          x:DataType="splitButtons:SplitButtonsViewModel">
  <maui:ReactiveContentPage.Resources>
    <ResourceDictionary>
      <DataTemplate x:Key="SplitButtonPopupTemplate">
        <Border BackgroundColor="LightGray"
                Stroke="DarkGray"
                StrokeThickness="1">
          <Border.StrokeShape>
            <RoundRectangle CornerRadius="2" />
          </Border.StrokeShape>
          <HorizontalStackLayout Margin="8" Spacing="8">
            <Label Text="This is the content of the SplitButton popup" />
            <styling:PackIcon VerticalOptions="Center" Kind="ThumbUp" />
          </HorizontalStackLayout>
        </Border>
      </DataTemplate>
    </ResourceDictionary>
  </maui:ReactiveContentPage.Resources>
  <ScrollView>
    <VerticalStackLayout Padding="24" Spacing="24">
      <Label Style="{StaticResource MaterialDesignHeadlineMediumTextBlock}" Text="Split Buttons" />

      <VerticalStackLayout Spacing="16">
        <HorizontalStackLayout Spacing="12">
          <styling:SplitButton IsEnabled="{Binding ControlsEnabled}" Content="Split Button"
                               PopupContent="Popup"
                               PopupContentTemplate="{StaticResource SplitButtonPopupTemplate}" />
          <styling:SplitButton IsEnabled="{Binding ControlsEnabled}" Content="Split Button"
                               Style="{StaticResource MaterialDesignRaisedLightSplitButton}"
                               PopupContent="Popup"
                               PopupContentTemplate="{StaticResource SplitButtonPopupTemplate}" />
          <styling:SplitButton IsEnabled="{Binding ControlsEnabled}" Content="Split Button"
                               Style="{StaticResource MaterialDesignRaisedDarkSplitButton}"
                               PopupContent="Popup"
                               PopupContentTemplate="{StaticResource SplitButtonPopupTemplate}" />
        </HorizontalStackLayout>

        <HorizontalStackLayout Spacing="12">
          <styling:SplitButton IsEnabled="{Binding ControlsEnabled}" Content="Split Button"
                               Style="{StaticResource MaterialDesignRaisedSecondarySplitButton}"
                               PopupContent="Popup"
                               PopupContentTemplate="{StaticResource SplitButtonPopupTemplate}" />
          <styling:SplitButton IsEnabled="{Binding ControlsEnabled}" Content="Split Button"
                               Style="{StaticResource MaterialDesignRaisedSecondaryLightSplitButton}"
                               PopupContent="Popup"
                               PopupContentTemplate="{StaticResource SplitButtonPopupTemplate}" />
          <styling:SplitButton IsEnabled="{Binding ControlsEnabled}" Content="Split Button"
                               Style="{StaticResource MaterialDesignRaisedSecondaryDarkSplitButton}"
                               PopupContent="Popup"
                               PopupContentTemplate="{StaticResource SplitButtonPopupTemplate}" />
        </HorizontalStackLayout>

        <HorizontalStackLayout Spacing="12">
          <styling:SplitButton IsEnabled="{Binding ControlsEnabled}" Content="Split Button"
                               Style="{StaticResource MaterialDesignOutlinedSplitButton}"
                               PopupContent="Popup"
                               PopupContentTemplate="{StaticResource SplitButtonPopupTemplate}" />
          <styling:SplitButton IsEnabled="{Binding ControlsEnabled}" Content="Split Button"
                               Style="{StaticResource MaterialDesignOutlinedLightSplitButton}"
                               PopupContent="Popup"
                               PopupContentTemplate="{StaticResource SplitButtonPopupTemplate}" />
          <styling:SplitButton IsEnabled="{Binding ControlsEnabled}" Content="Split Button"
                               Style="{StaticResource MaterialDesignOutlinedDarkSplitButton}"
                               PopupContent="Popup"
                               PopupContentTemplate="{StaticResource SplitButtonPopupTemplate}" />
        </HorizontalStackLayout>

        <HorizontalStackLayout Spacing="12">
          <styling:SplitButton IsEnabled="{Binding ControlsEnabled}" Content="Split Button"
                               Style="{StaticResource MaterialDesignOutlinedSecondarySplitButton}"
                               PopupContent="Popup"
                               PopupContentTemplate="{StaticResource SplitButtonPopupTemplate}" />
          <styling:SplitButton IsEnabled="{Binding ControlsEnabled}" Content="Split Button"
                               Style="{StaticResource MaterialDesignOutlinedSecondaryLightSplitButton}"
                               PopupContent="Popup"
                               PopupContentTemplate="{StaticResource SplitButtonPopupTemplate}" />
          <styling:SplitButton IsEnabled="{Binding ControlsEnabled}" Content="Split Button"
                               Style="{StaticResource MaterialDesignOutlinedSecondaryDarkSplitButton}"
                               PopupContent="Popup"
                               PopupContentTemplate="{StaticResource SplitButtonPopupTemplate}" />
        </HorizontalStackLayout>

        <HorizontalStackLayout Spacing="12">
          <styling:SplitButton IsEnabled="{Binding ControlsEnabled}" Content="Split Button"
                               Style="{StaticResource MaterialDesignFlatSplitButton}"
                               PopupContent="Popup"
                               PopupContentTemplate="{StaticResource SplitButtonPopupTemplate}" />
          <styling:SplitButton IsEnabled="{Binding ControlsEnabled}" Content="Split Button"
                               Style="{StaticResource MaterialDesignFlatLightSplitButton}"
                               PopupContent="Popup"
                               PopupContentTemplate="{StaticResource SplitButtonPopupTemplate}" />
          <styling:SplitButton IsEnabled="{Binding ControlsEnabled}" Content="Split Button"
                               Style="{StaticResource MaterialDesignFlatDarkSplitButton}"
                               PopupContent="Popup"
                               PopupContentTemplate="{StaticResource SplitButtonPopupTemplate}" />
        </HorizontalStackLayout>

        <HorizontalStackLayout Spacing="12">
          <styling:SplitButton IsEnabled="{Binding ControlsEnabled}" Content="Split Button"
                               Style="{StaticResource MaterialDesignFlatSecondarySplitButton}"
                               PopupContent="Popup"
                               PopupContentTemplate="{StaticResource SplitButtonPopupTemplate}" />
          <styling:SplitButton IsEnabled="{Binding ControlsEnabled}" Content="Split Button"
                               Style="{StaticResource MaterialDesignFlatSecondaryLightSplitButton}"
                               PopupContent="Popup"
                               PopupContentTemplate="{StaticResource SplitButtonPopupTemplate}" />
          <styling:SplitButton IsEnabled="{Binding ControlsEnabled}" Content="Split Button"
                               Style="{StaticResource MaterialDesignFlatSecondaryDarkSplitButton}"
                               PopupContent="Popup"
                               PopupContentTemplate="{StaticResource SplitButtonPopupTemplate}" />
        </HorizontalStackLayout>
        <HorizontalStackLayout Spacing="12">
          <styling:SplitButton IsEnabled="{Binding ControlsEnabled}" Content="Split Button"
                               Style="{StaticResource MaterialDesignFlatSplitButton}"
                               PopupContent="Popup"
                               PopupContentTemplate="{StaticResource SplitButtonPopupTemplate}" />
          <styling:SplitButton IsEnabled="{Binding ControlsEnabled}" Content="Split Button"
                               Style="{StaticResource MaterialDesignFlatLightSplitButton}"
                               PopupContent="Popup"
                               PopupContentTemplate="{StaticResource SplitButtonPopupTemplate}" />
          <styling:SplitButton IsEnabled="{Binding ControlsEnabled}" Content="Split Button"
                               Style="{StaticResource MaterialDesignFlatDarkSplitButton}"
                               PopupContent="Popup"
                               PopupContentTemplate="{StaticResource SplitButtonPopupTemplate}" />
        </HorizontalStackLayout>
        <HorizontalStackLayout Spacing="12">
          <styling:SplitButton IsEnabled="{Binding ControlsEnabled}" Content="Split Button"
                               Style="{StaticResource MaterialDesignFlatSecondarySplitButton}"
                               PopupContent="Popup"
                               PopupContentTemplate="{StaticResource SplitButtonPopupTemplate}" />
          <styling:SplitButton IsEnabled="{Binding ControlsEnabled}" Content="Split Button"
                               Style="{StaticResource MaterialDesignFlatSecondaryLightSplitButton}"
                               PopupContent="Popup"
                               PopupContentTemplate="{StaticResource SplitButtonPopupTemplate}" />
          <styling:SplitButton IsEnabled="{Binding ControlsEnabled}" Content="Split Button"
                               Style="{StaticResource MaterialDesignFlatSecondaryDarkSplitButton}"
                               PopupContent="Popup"
                               PopupContentTemplate="{StaticResource SplitButtonPopupTemplate}" />
        </HorizontalStackLayout>

        <Label Style="{StaticResource MaterialDesignTitleSmallTextBlock}" Text="Split Buttons Options" />
        <HorizontalStackLayout Spacing="12">
          <styling:SplitButton IsEnabled="{Binding ControlsEnabled}"
                               Content="Corners"
                               Style="{StaticResource MaterialDesignOutlinedSplitButton}"
                               PopupUniformCornerRadius="10"
                               PopupContent="Popup"
                               PopupContentTemplate="{StaticResource SplitButtonPopupTemplate}" />
          <styling:SplitButton IsEnabled="{Binding ControlsEnabled}"
                               Content="Open Up"
                               Style="{StaticResource MaterialDesignOutlinedSplitButton}"
                               PopupPlacementMode="TopAndAlignCentres"
                               PopupContent="Popup"
                               PopupContentTemplate="{StaticResource SplitButtonPopupTemplate}" />
          <styling:SplitButton IsEnabled="{Binding ControlsEnabled}"
                               Content="Popup Corners"
                               Style="{StaticResource MaterialDesignOutlinedSplitButton}"
                               PopupElevation="Dp6"
                               PopupPlacementMode="RightAndAlignBottomEdges"
                               PopupUniformCornerRadius="10"
                               PopupContent="Popup"
                               PopupContentTemplate="{StaticResource SplitButtonPopupTemplate}" />
        </HorizontalStackLayout>
      </VerticalStackLayout>
    </VerticalStackLayout>
  </ScrollView>
</maui:ReactiveContentPage>
