             xmlns:styling="clr-namespace:MaterialDesignThemes.Maui;assembly=MaterialDesignThemes.Maui"
             xmlns:themes="clr-namespace:MaterialDesignThemes.Maui.Themes;assembly=MaterialDesignThemes.Maui"
             xmlns:transitions="clr-namespace:MaterialDesignDemo.Maui.Transitions"
             x:Class="MaterialDesignDemo.Maui.App">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <styling:MaterialDesignColorsDictionary />
        <themes:MaterialDesign3 />
      </ResourceDictionary.MergedDictionaries>
      <transitions:NotBoolConverter x:Key="NotBoolConverter" />
    </ResourceDictionary>
  </Application.Resources>
</Application>
