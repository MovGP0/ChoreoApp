<?xml version="1.0" encoding="utf-8" ?>
<maui:ReactiveContentPage x:TypeArguments="main:MainViewModel"
                          xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                          xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                          xmlns:maui="using:ReactiveUI.Maui"
                          xmlns:styling="clr-namespace:MaterialDesignThemes.Maui;assembly=MaterialDesignThemes.Maui"
                          xmlns:floor="clr-namespace:ChoreoApp.Floor"
                          xmlns:scenes="clr-namespace:ChoreoApp.Scenes"
                          xmlns:audio="clr-namespace:ChoreoApp.AudioPlayer"
                          xmlns:settings="clr-namespace:ChoreoApp.ChoreographySettings"
                          xmlns:main="clr-namespace:ChoreoApp.Main"
                          xmlns:i18n="clr-namespace:ChoreoApp.i18n;assembly=ChoreoApp.i18n"
                          x:Name="Root"
                          x:DataType="main:MainViewModel"
                          x:Class="ChoreoApp.Main.MainPage">
    <Shell.TitleView>
        <Grid Padding="12,8"
              ColumnDefinitions="Auto,*"
              BackgroundColor="{DynamicResource Key={x:Static styling:MaterialDesignColorKey.Surface}}">
            <styling:HamburgerToggleButton x:Name="HamburgerButton"
                                           Grid.Column="0"
                                           Style="{StaticResource MaterialDesignHamburgerToggleButton}"
                                           Checked="OnBurgerClicked"
                                           Unchecked="OnBurgerClicked" />
            <HorizontalStackLayout Grid.Column="1"
                                   HorizontalOptions="End"
                                   VerticalOptions="Center"
                                   Spacing="8">
                  <Picker x:DataType="main:InteractionModeOption"
                          ItemsSource="{Binding Source={x:Reference Root}, Path=BindingContext.ModeOptions, x:DataType=main:MainViewModel}"
                          SelectedItem="{Binding Source={x:Reference Root}, Path=BindingContext.SelectedModeOption, x:DataType=main:MainViewModel}"
                          ItemDisplayBinding="{Binding Display}"
                          IsEnabled="{Binding Source={x:Reference Root}, Path=BindingContext.IsModeSelectionEnabled, x:DataType=main:MainViewModel}"
                          TextColor="{DynamicResource Key={x:Static styling:MaterialDesignColorKey.OnSurface}}"
                          BackgroundColor="{DynamicResource Key={x:Static styling:MaterialDesignColorKey.SurfaceVariant}}"
                          HeightRequest="32"
                          WidthRequest="180" />
                <styling:ContentButton Style="{StaticResource MaterialDesignIconButton}"
                                       Command="{Binding OpenChoreographySettingsCommand}">
                    <styling:PackIcon Kind="Pen" />
                </styling:ContentButton>
                <styling:ContentButton Style="{StaticResource MaterialDesignIconButton}"
                                       Command="{Binding OpenImageCommand}">
                    <styling:PackIcon Kind="Svg" />
                </styling:ContentButton>
                <styling:ContentButton Style="{StaticResource MaterialDesignIconButton}"
                                       Command="{Binding ToggleAudioPlayerCommand}">
                    <styling:PackIcon Kind="PlayCircle" />
                </styling:ContentButton>
            </HorizontalStackLayout>
        </Grid>
    </Shell.TitleView>
    <styling:DialogHost x:Name="MainDialogHost"
                        IsOpen="{Binding IsDialogOpen, Mode=TwoWay}"
                        DialogContent="{Binding DialogContentView}">
        <Grid RowDefinitions="Auto,*,Auto">
            <styling:DrawerHost x:Name="Drawer"
                                Grid.Row="1"
                                ResponsiveBreakpoint="900"
                                OpenMode="Default"
                                BottomDrawerHeight="60"
                                IsRightDrawerOpen="{Binding IsChoreographySettingsOpen, Mode=TwoWay}">
                <styling:DrawerHost.LeftDrawerContent>
                    <Border BackgroundColor="{DynamicResource Key={x:Static styling:MaterialDesignColorKey.SurfaceVariant}}"
                            MaximumWidthRequest="600">
                        <scenes:ScenesPaneView x:Name="LeftDrawerScenes" />
                    </Border>
                </styling:DrawerHost.LeftDrawerContent>
                <styling:DrawerHost.RightDrawerContent>
                    <Border BackgroundColor="{DynamicResource Key={x:Static styling:MaterialDesignColorKey.SurfaceVariant}}"
                            MaximumWidthRequest="480">
                        <settings:ChoreographySettingsView x:Name="RightDrawerChoreographySettings" />
                    </Border>
                </styling:DrawerHost.RightDrawerContent>
                <styling:DrawerHost.MainContent>
                    <Grid>
                        <floor:FloorCanvasView x:Name="MainFloor" />
                    </Grid>
                </styling:DrawerHost.MainContent>
            </styling:DrawerHost>
            <audio:AudioPlayerView Grid.Row="2"
                                   x:Name="BottomAudioPlayer"
                                   IsVisible="{Binding IsAudioPlayerOpen}" />
        </Grid>
    </styling:DialogHost>
</maui:ReactiveContentPage>
