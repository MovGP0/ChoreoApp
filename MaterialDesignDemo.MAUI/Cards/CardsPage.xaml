<?xml version="1.0" encoding="utf-8" ?>
<maui:ReactiveContentPage x:TypeArguments="cards:CardsViewModel"
                          xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                          xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                          xmlns:cards="clr-namespace:MaterialDesignDemo.Maui.Cards"
                          xmlns:maui="using:ReactiveUI.Maui"
                          xmlns:styling="clr-namespace:MaterialDesignThemes.Maui;assembly=MaterialDesignThemes.Maui"
                          x:Class="MaterialDesignDemo.Maui.Cards.CardsPage"
                          x:DataType="cards:CardsViewModel">
  <ScrollView>
    <VerticalStackLayout Padding="24" Spacing="24">
      <Label Style="{StaticResource MaterialDesignHeadlineMediumTextBlock}" Text="Card" />

      <FlexLayout Wrap="Wrap" Direction="Row" JustifyContent="Start" AlignItems="Start">
        <styling:Card WidthRequest="220" Margin="0,0,16,16">
          <Grid RowDefinitions="140,*,Auto">
            <Image HeightRequest="140" Source="contact.png" Aspect="AspectFill" />
            <styling:ContentButton Grid.Row="0"
                                   Margin="0,0,16,-20"
                                   HorizontalOptions="End"
                                   VerticalOptions="End"
                                   Style="{StaticResource MaterialDesignFloatingActionMiniButton}">
              <styling:PackIcon Kind="Bike" />
            </styling:ContentButton>
            <VerticalStackLayout Grid.Row="1" Margin="12,24,12,0" Spacing="6">
              <Label FontAttributes="Bold" Text="Cycling" />
              <Label Text="A great way to keep fit and forget about the constant grind of IT."
                     LineBreakMode="WordWrap" />
            </VerticalStackLayout>
            <HorizontalStackLayout Grid.Row="2" Margin="8" HorizontalOptions="End" Spacing="8">
              <styling:ContentButton Style="{StaticResource MaterialDesignToolButton}">
                <styling:PackIcon Kind="ShareVariant" />
              </styling:ContentButton>
              <styling:ContentButton Style="{StaticResource MaterialDesignToolButton}">
                <styling:PackIcon Kind="Heart" />
              </styling:ContentButton>
              <styling:PopupBox Style="{StaticResource MaterialDesignToolPopupBox}">
                <VerticalStackLayout Padding="8" Spacing="4">
                  <styling:ContentButton Style="{StaticResource MaterialDesignFlatButton}">
                    <Label Text="More" />
                  </styling:ContentButton>
                  <styling:ContentButton Style="{StaticResource MaterialDesignFlatButton}">
                    <Label Text="Options" />
                  </styling:ContentButton>
                </VerticalStackLayout>
              </styling:PopupBox>
            </HorizontalStackLayout>
          </Grid>
        </styling:Card>

        <styling:Card WidthRequest="220" Margin="0,0,16,16" Style="{StaticResource MaterialDesignOutlinedCard}">
          <VerticalStackLayout Padding="12" Spacing="8">
            <Image HeightRequest="120" Source="contact.png" Aspect="AspectFill" />
            <Label FontAttributes="Bold" Text="Outlined style" />
            <Label Text="Removes the drop shadow and flattens the look of the card." LineBreakMode="WordWrap" />
          </VerticalStackLayout>
        </styling:Card>

        <styling:Card WidthRequest="220" Margin="0,0,16,16"
                      BackgroundColor="{DynamicResource Key={x:Static styling:MaterialDesignColorKey.Primary}}"
                      Foreground="{DynamicResource Key={x:Static styling:MaterialDesignColorKey.OnPrimary}}">
          <VerticalStackLayout Padding="12" Spacing="8">
            <Label FontSize="18" Text="Call Jennifer" />
            <BoxView HeightRequest="1"
                     BackgroundColor="{DynamicResource Key={x:Static styling:MaterialDesignColorKey.OnPrimary}}"
                     Opacity="0.4" />
            <Label Text="March 19, 2016" />
            <HorizontalStackLayout HorizontalOptions="End" Spacing="8">
              <styling:ContentButton Style="{StaticResource MaterialDesignToolForegroundButton}">
                <styling:PackIcon Kind="Phone" />
              </styling:ContentButton>
              <styling:PopupBox Style="{StaticResource MaterialDesignToolForegroundPopupBox}">
                <VerticalStackLayout Padding="8" Spacing="4">
                  <styling:ContentButton Style="{StaticResource MaterialDesignFlatButton}">
                    <Label Text="More" />
                  </styling:ContentButton>
                  <styling:ContentButton Style="{StaticResource MaterialDesignFlatButton}">
                    <Label Text="Options" />
                  </styling:ContentButton>
                </VerticalStackLayout>
              </styling:PopupBox>
            </HorizontalStackLayout>
          </VerticalStackLayout>
        </styling:Card>

        <styling:Card WidthRequest="220" Margin="0,0,16,16"
                      BackgroundColor="{DynamicResource Key={x:Static styling:MaterialDesignColorKey.PrimaryContainer}}"
                      Foreground="{DynamicResource Key={x:Static styling:MaterialDesignColorKey.OnPrimaryContainer}}"
                      UniformCornerRadius="6">
          <VerticalStackLayout Padding="12" Spacing="6">
            <Label FontAttributes="Bold" Text="Notes" />
            <HorizontalStackLayout Spacing="8">
              <CheckBox Style="{StaticResource MaterialDesignCheckBox}" />
              <Label Text="Do something good" VerticalOptions="Center" />
            </HorizontalStackLayout>
            <HorizontalStackLayout Spacing="8">
              <CheckBox Style="{StaticResource MaterialDesignCheckBox}" />
              <Label Text="Take a breather" VerticalOptions="Center" />
            </HorizontalStackLayout>
            <HorizontalStackLayout Spacing="8">
              <CheckBox Style="{StaticResource MaterialDesignCheckBox}" />
              <Label Text="And go create" VerticalOptions="Center" />
            </HorizontalStackLayout>
          </VerticalStackLayout>
        </styling:Card>
      </FlexLayout>

      <Label Style="{StaticResource MaterialDesignTitleMediumTextBlock}" Text="Flipper" />
      <HorizontalStackLayout Spacing="16">
        <styling:Flipper>
          <styling:Flipper.FrontContent>
            <styling:ContentButton Style="{StaticResource MaterialDesignFlatButton}">
              <Label Text="FLIPPABLZ!" />
            </styling:ContentButton>
          </styling:Flipper.FrontContent>
          <styling:Flipper.BackContent>
            <styling:ContentButton Style="{StaticResource MaterialDesignFlatButton}">
              <Label Text="GO BACK" />
            </styling:ContentButton>
          </styling:Flipper.BackContent>
        </styling:Flipper>

        <styling:FlipperClassic>
          <styling:FlipperClassic.FrontContent>
            <styling:ContentButton Style="{StaticResource MaterialDesignFlatButton}">
              <Label Text="Rounded Flipper" />
            </styling:ContentButton>
          </styling:FlipperClassic.FrontContent>
          <styling:FlipperClassic.BackContent>
            <styling:ContentButton Style="{StaticResource MaterialDesignFlatButton}">
              <Label Text="GO BACK" />
            </styling:ContentButton>
          </styling:FlipperClassic.BackContent>
        </styling:FlipperClassic>
      </HorizontalStackLayout>
    </VerticalStackLayout>
  </ScrollView>
</maui:ReactiveContentPage>
