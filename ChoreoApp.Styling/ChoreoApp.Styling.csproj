<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>
      net10.0;
      net10.0-android;
      net10.0-ios;
      net10.0-maccatalyst;
      net10.0-windows10.0.19041.0
    </TargetFrameworks>
    <OutputType>Library</OutputType>
    <UseMaui>true</UseMaui>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-windows10.0.19041.0'">
    <!-- Avoid WinUI XBF generation for MAUI resource dictionaries -->
    <DisableXbfGeneration>true</DisableXbfGeneration>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="Microsoft.Maui" />
    <Using Include="Microsoft.Maui.Controls" />
    <Using Include="Microsoft.Maui.Graphics" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls.Core" />
    <PackageReference Include="PolySharp" />
    <PackageReference Include="ReactiveMarbles.ObservableEvents.SourceGenerator" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\MaterialColorUtilities\MaterialColorUtilities.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Update="MaterialDesignColorsDictionary.*.cs">
      <DependentUpon>MaterialDesignColorsDictionary.cs</DependentUpon>
    </Compile>
    <Compile Update="TextBlockAssist.Windows.cs">
      <DependentUpon>TextBlockAssist.cs</DependentUpon>
    </Compile>
    <Compile Update="TextBlockAssist.Default.cs">
      <DependentUpon>TextBlockAssist.cs</DependentUpon>
    </Compile>
    <Compile Update="DrawerHost.LeftDrawer.cs">
      <DependentUpon>DrawerHost.cs</DependentUpon>
    </Compile>
    <Compile Update="DrawerHost.RightDrawer.cs">
      <DependentUpon>DrawerHost.cs</DependentUpon>
    </Compile>
    <Compile Update="DrawerHost.TopDrawer.cs">
      <DependentUpon>DrawerHost.cs</DependentUpon>
    </Compile>
    <Compile Update="DrawerHost.BottomDrawer.cs">
      <DependentUpon>DrawerHost.cs</DependentUpon>
    </Compile>
  </ItemGroup>
</Project>
