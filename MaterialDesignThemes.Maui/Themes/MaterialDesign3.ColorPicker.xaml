<?xml version="1.0" encoding="UTF-8"?>
<ResourceDictionary
  xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
  xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
  xmlns:styling="clr-namespace:MaterialDesignThemes.Maui;assembly=MaterialDesignThemes.Maui">

  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="MaterialDesign3.Slider.xaml" />
  </ResourceDictionary.MergedDictionaries>

  <Style x:Key="MaterialDesignColorPicker"
         TargetType="styling:ColorPicker">
    <Setter Property="BackgroundColor"
            Value="{DynamicResource Key={x:Static styling:MaterialDesignColorKey.SurfaceContainerLow}}" />
    <Setter Property="Padding" Value="12" />
    <Setter Property="HueSliderPosition" Value="Bottom" />
    <Setter Property="Resources">
      <ResourceDictionary>
        <Style TargetType="Slider">
          <Setter Property="MinimumTrackColor"
                  Value="{DynamicResource Key={x:Static styling:MaterialDesignColorKey.Primary}}" />
          <Setter Property="MaximumTrackColor"
                  Value="{DynamicResource Key={x:Static styling:MaterialDesignColorKey.SurfaceVariant}}" />
          <Setter Property="ThumbColor"
                  Value="{DynamicResource Key={x:Static styling:MaterialDesignColorKey.Primary}}" />
          <Setter Property="Minimum" Value="0" />
          <Setter Property="Maximum" Value="360" />
        </Style>
      </ResourceDictionary>
    </Setter>
  </Style>

  <Style TargetType="styling:ColorPicker"
         BasedOn="{StaticResource MaterialDesignColorPicker}" />
</ResourceDictionary>
