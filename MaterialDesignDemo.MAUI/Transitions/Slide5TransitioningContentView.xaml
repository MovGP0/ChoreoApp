<?xml version="1.0" encoding="utf-8" ?>
<maui:ReactiveContentView x:TypeArguments="transitions:TransitionsDemoViewModel"
                          xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                          xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                          xmlns:maui="using:ReactiveUI.Maui"
                          xmlns:styling="clr-namespace:MaterialDesignThemes.Maui;assembly=MaterialDesignThemes.Maui"
                          xmlns:transitions="clr-namespace:MaterialDesignDemo.Maui.Transitions"
                          x:Class="MaterialDesignDemo.Maui.Transitions.Slide5TransitioningContentView"
                          x:DataType="transitions:TransitionsDemoViewModel">
  <Grid Padding="24" RowDefinitions="Auto,Auto,Auto" RowSpacing="24">
    <styling:Card Style="{StaticResource MaterialDesignElevatedCard}">
      <HorizontalStackLayout Padding="16" Spacing="16">
        <styling:PackIcon WidthRequest="32" HeightRequest="32" Kind="Account" />
        <Label Style="{StaticResource MaterialDesignHeadlineSmallTextBlock}" Text="Contacts" />
      </HorizontalStackLayout>
    </styling:Card>

    <Grid Grid.Row="1" RowDefinitions="Auto,Auto" ColumnDefinitions="*,*,*,*" ColumnSpacing="8" RowSpacing="8">
      <styling:Card Style="{StaticResource MaterialDesignElevatedCard}" HeightRequest="96" WidthRequest="96">
        <styling:PackIcon HorizontalOptions="Center" VerticalOptions="Center" Kind="Phone" />
      </styling:Card>
      <styling:Card Grid.Column="1" Style="{StaticResource MaterialDesignElevatedCard}" HeightRequest="96" WidthRequest="96">
        <styling:PackIcon HorizontalOptions="Center" VerticalOptions="Center" Kind="Phone" />
      </styling:Card>
      <styling:Card Grid.Column="2" Style="{StaticResource MaterialDesignElevatedCard}" HeightRequest="96" WidthRequest="96">
        <styling:PackIcon HorizontalOptions="Center" VerticalOptions="Center" Kind="Phone" />
      </styling:Card>
      <styling:Card Grid.Column="3" Style="{StaticResource MaterialDesignElevatedCard}" HeightRequest="96" WidthRequest="96">
        <styling:PackIcon HorizontalOptions="Center" VerticalOptions="Center" Kind="Phone" />
      </styling:Card>
      <styling:Card Grid.Row="1" Style="{StaticResource MaterialDesignElevatedCard}" HeightRequest="96" WidthRequest="96">
        <styling:PackIcon HorizontalOptions="Center" VerticalOptions="Center" Kind="Phone" />
      </styling:Card>
      <styling:Card Grid.Row="1" Grid.Column="1" Style="{StaticResource MaterialDesignElevatedCard}" HeightRequest="96" WidthRequest="96">
        <styling:PackIcon HorizontalOptions="Center" VerticalOptions="Center" Kind="Phone" />
      </styling:Card>
      <styling:Card Grid.Row="1" Grid.Column="2" Style="{StaticResource MaterialDesignElevatedCard}" HeightRequest="96" WidthRequest="96">
        <styling:PackIcon HorizontalOptions="Center" VerticalOptions="Center" Kind="Phone" />
      </styling:Card>
      <styling:Card Grid.Row="1" Grid.Column="3" Style="{StaticResource MaterialDesignElevatedCard}" HeightRequest="96" WidthRequest="96">
        <styling:PackIcon HorizontalOptions="Center" VerticalOptions="Center" Kind="Phone" />
      </styling:Card>
    </Grid>

    <HorizontalStackLayout Grid.Row="2" HorizontalOptions="End" Spacing="16">
      <styling:ContentButton Style="{StaticResource MaterialDesignIconButton}"
                             Command="{Binding MovePreviousCommand}">
        <styling:PackIcon Kind="StepBackward" />
      </styling:ContentButton>
      <styling:ContentButton Style="{StaticResource MaterialDesignIconButton}"
                             Command="{Binding MoveNextCommand}">
        <styling:PackIcon Kind="StepForward" />
      </styling:ContentButton>
    </HorizontalStackLayout>
  </Grid>
</maui:ReactiveContentView>
