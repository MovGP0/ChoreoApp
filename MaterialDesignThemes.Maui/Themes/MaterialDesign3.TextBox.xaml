<?xml version="1.0" encoding="UTF-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    xmlns:styling="clr-namespace:MaterialDesignThemes.Maui;assembly=MaterialDesignThemes.Maui">

  <Style x:Key="MaterialDesignHelperTextBlock"
         TargetType="Label">
    <Setter Property="FontSize" Value="10" />
    <Setter Property="TextColor" Value="{DynamicResource Key={x:Static styling:MaterialDesignColorKey.OnSurfaceVariant}}" />
    <Setter Property="Opacity" Value="0.56" />
  </Style>

  <Style x:Key="MaterialDesignTextBox"
         TargetType="Entry">
    <Setter Property="BackgroundColor" Value="Transparent" />
    <Setter Property="TextColor" Value="{DynamicResource Key={x:Static styling:MaterialDesignColorKey.OnSurface}}" />
    <Setter Property="PlaceholderColor" Value="{DynamicResource Key={x:Static styling:MaterialDesignColorKey.OnSurfaceVariant}}" />
    <Setter Property="CursorPosition" Value="0" />
    <Setter Property="ClearButtonVisibility" Value="Never" />
  </Style>

  <Style x:Key="MaterialDesignTextBoxMultiLine"
         TargetType="Editor">
    <Setter Property="BackgroundColor" Value="Transparent" />
    <Setter Property="TextColor" Value="{DynamicResource Key={x:Static styling:MaterialDesignColorKey.OnSurface}}" />
    <Setter Property="PlaceholderColor" Value="{DynamicResource Key={x:Static styling:MaterialDesignColorKey.OnSurfaceVariant}}" />
  </Style>

  <Style TargetType="Entry"
         BasedOn="{StaticResource MaterialDesignTextBox}" />

  <Style TargetType="Editor"
         BasedOn="{StaticResource MaterialDesignTextBoxMultiLine}" />
</ResourceDictionary>
