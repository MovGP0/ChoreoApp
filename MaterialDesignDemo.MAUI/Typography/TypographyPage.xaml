<?xml version="1.0" encoding="utf-8" ?>
<maui:ReactiveContentPage x:TypeArguments="typography:TypographyViewModel"
                          xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                          xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                          xmlns:maui="using:ReactiveUI.Maui"
                          xmlns:styling="clr-namespace:MaterialDesignThemes.Maui;assembly=MaterialDesignThemes.Maui"
                          xmlns:typography="using:MaterialDesignDemo.Maui.Typography"
                          x:Class="MaterialDesignDemo.Maui.Typography.TypographyPage"
                          x:DataType="typography:TypographyViewModel">
  <maui:ReactiveContentPage.Resources>
    <Style x:Key="CaptionLabel" TargetType="Label">
      <Setter Property="TextColor" Value="{DynamicResource Key={x:Static styling:MaterialDesignColorKey.OnSurfaceVariant}}" />
      <Setter Property="Opacity" Value="0.68" />
    </Style>
  </maui:ReactiveContentPage.Resources>

  <ScrollView>
    <Grid Padding="24"
          RowSpacing="12"
          ColumnDefinitions="Auto,24,*">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <Label Grid.Row="0" Grid.Column="0" Margin="0,12,0,0" Style="{StaticResource CaptionLabel}"
             Text="Headline Large - MaterialDesignHeadlineLargeTextBlock" />
      <Label Grid.Row="0" Grid.Column="2" Style="{StaticResource MaterialDesignHeadlineLargeTextBlock}"
             Text="Light 96sp" />

      <Label Grid.Row="1" Grid.Column="0" Margin="0,8,0,0" Style="{StaticResource CaptionLabel}"
             Text="Headline Medium - MaterialDesignHeadlineMediumTextBlock" />
      <Label Grid.Row="1" Grid.Column="2" Style="{StaticResource MaterialDesignHeadlineMediumTextBlock}"
             Text="Light 60sp" />

      <Label Grid.Row="2" Grid.Column="0" Margin="0,8,0,0" Style="{StaticResource CaptionLabel}"
             Text="Headline Small - MaterialDesignHeadlineSmallTextBlock" />
      <Label Grid.Row="2" Grid.Column="2" Style="{StaticResource MaterialDesignHeadlineSmallTextBlock}"
             Text="Regular 48sp" />

      <Label Grid.Row="3" Grid.Column="0" Margin="0,8,0,0" Style="{StaticResource CaptionLabel}"
             Text="Title Large - MaterialDesignTitleLargeTextBlock" />
      <Label Grid.Row="3" Grid.Column="2" Style="{StaticResource MaterialDesignTitleLargeTextBlock}"
             Text="Regular 34sp" />

      <Label Grid.Row="4" Grid.Column="0" Margin="0,8,0,0" Style="{StaticResource CaptionLabel}"
             Text="Title Medium - MaterialDesignTitleMediumTextBlock" />
      <Label Grid.Row="4" Grid.Column="2" Style="{StaticResource MaterialDesignTitleMediumTextBlock}"
             Text="Regular 24sp" />

      <Label Grid.Row="5" Grid.Column="0" Margin="0,8,0,0" Style="{StaticResource CaptionLabel}"
             Text="Title Small - MaterialDesignTitleSmallTextBlock" />
      <Label Grid.Row="5" Grid.Column="2" Style="{StaticResource MaterialDesignTitleSmallTextBlock}"
             Text="Medium 20sp" />

      <Label Grid.Row="6" Grid.Column="0" Style="{StaticResource CaptionLabel}"
             Text="Body Large - MaterialDesignBodyLargeTextBlock" />
      <Label Grid.Row="6" Grid.Column="2" Style="{StaticResource MaterialDesignBodyLargeTextBlock}"
             Text="Regular 16sp" />

      <Label Grid.Row="7" Grid.Column="0" Style="{StaticResource CaptionLabel}"
             Text="Body Medium - MaterialDesignBodyMediumTextBlock" />
      <Label Grid.Row="7" Grid.Column="2" Style="{StaticResource MaterialDesignBodyMediumTextBlock}"
             Text="Regular 14sp" />

      <Label Grid.Row="8" Grid.Column="0" Style="{StaticResource CaptionLabel}"
             Text="Body Small - MaterialDesignBodySmallTextBlock" />
      <Label Grid.Row="8" Grid.Column="2" Style="{StaticResource MaterialDesignBodySmallTextBlock}"
             Text="Regular 12sp" />

      <Label Grid.Row="9" Grid.Column="0" Style="{StaticResource CaptionLabel}"
             Text="Label Large - MaterialDesignLabelLargeTextBlock" />
      <Label Grid.Row="9" Grid.Column="2" Style="{StaticResource MaterialDesignLabelLargeTextBlock}"
             Text="REGULAR 14sp" />

      <Label Grid.Row="10" Grid.Column="0" Style="{StaticResource CaptionLabel}"
             Text="Label Medium - MaterialDesignLabelMediumTextBlock" />
      <Label Grid.Row="10" Grid.Column="2" Style="{StaticResource MaterialDesignLabelMediumTextBlock}"
             Text="MEDIUM 12sp" />

      <Label Grid.Row="11" Grid.Column="0" Style="{StaticResource CaptionLabel}"
             Text="Label Small - MaterialDesignLabelSmallTextBlock" />
      <Label Grid.Row="11" Grid.Column="2" Style="{StaticResource MaterialDesignLabelSmallTextBlock}"
             Text="MEDIUM 11sp" />

      <Label Grid.Row="12" Grid.Column="0" Style="{StaticResource CaptionLabel}"
             Text="Display Large - MaterialDesignDisplayLargeTextBlock" />
      <Label Grid.Row="12" Grid.Column="2" Style="{StaticResource MaterialDesignDisplayLargeTextBlock}"
             Text="DISPLAY 57sp" />
    </Grid>
  </ScrollView>
</maui:ReactiveContentPage>
