<?xml version="1.0" encoding="utf-8" ?>
<maui:ReactiveContentPage x:TypeArguments="tabs:TabsViewModel"
                          xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                          xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                          xmlns:maui="using:ReactiveUI.Maui"
                          xmlns:styling="clr-namespace:MaterialDesignThemes.Maui;assembly=MaterialDesignThemes.Maui"
                          xmlns:tabs="clr-namespace:MaterialDesignDemo.Maui.Tabs"
                          x:Class="MaterialDesignDemo.Maui.Tabs.TabsPage"
                          x:DataType="tabs:TabsViewModel">
  <ScrollView>
    <VerticalStackLayout Padding="24" Spacing="24">
      <Label Style="{StaticResource MaterialDesignHeadlineMediumTextBlock}" Text="Tabs" />

      <Label Style="{StaticResource MaterialDesignTitleMediumTextBlock}" Text="Default" />
      <CollectionView ItemsSource="{Binding DefaultTabs}"
                      SelectionMode="Single"
                      SelectedItem="{Binding SelectedDefaultTab}">
        <CollectionView.ItemsLayout>
          <LinearItemsLayout Orientation="Horizontal" ItemSpacing="8" />
        </CollectionView.ItemsLayout>
        <CollectionView.ItemTemplate>
          <DataTemplate x:DataType="tabs:TabItem">
            <Border Padding="12,8" StrokeThickness="0" StrokeShape="RoundRectangle 8">
              <Label Text="{Binding Title}" />
              <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                  <VisualState x:Name="Normal">
                    <VisualState.Setters>
                      <Setter Property="BackgroundColor" Value="Transparent" />
                    </VisualState.Setters>
                  </VisualState>
                  <VisualState x:Name="Selected">
                    <VisualState.Setters>
                      <Setter Property="BackgroundColor" Value="{DynamicResource Key={x:Static styling:MaterialDesignColorKey.SurfaceContainerLow}}" />
                    </VisualState.Setters>
                  </VisualState>
                </VisualStateGroup>
              </VisualStateManager.VisualStateGroups>
            </Border>
          </DataTemplate>
        </CollectionView.ItemTemplate>
      </CollectionView>
      <styling:Card Style="{StaticResource MaterialDesignOutlinedCard}">
        <Label Padding="16" Text="{Binding SelectedDefaultTab.Content}" />
      </styling:Card>

      <Label Style="{StaticResource MaterialDesignTitleMediumTextBlock}" Text="Filled" />
      <styling:Card Style="{StaticResource MaterialDesignElevatedCard}">
        <VerticalStackLayout Padding="16" Spacing="12">
          <CollectionView ItemsSource="{Binding FilledTabs}"
                          SelectionMode="Single"
                          SelectedItem="{Binding SelectedFilledTab}">
            <CollectionView.ItemsLayout>
              <LinearItemsLayout Orientation="Horizontal" ItemSpacing="8" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
              <DataTemplate x:DataType="tabs:TabItem">
                <Border Padding="12,8" StrokeThickness="0" StrokeShape="RoundRectangle 8">
                  <Label Text="{Binding Title}" />
                  <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup x:Name="CommonStates">
                      <VisualState x:Name="Normal">
                        <VisualState.Setters>
                          <Setter Property="BackgroundColor" Value="Transparent" />
                        </VisualState.Setters>
                      </VisualState>
                      <VisualState x:Name="Selected">
                        <VisualState.Setters>
                          <Setter Property="BackgroundColor" Value="{DynamicResource Key={x:Static styling:MaterialDesignColorKey.PrimaryContainer}}" />
                        </VisualState.Setters>
                      </VisualState>
                    </VisualStateGroup>
                  </VisualStateManager.VisualStateGroups>
                </Border>
              </DataTemplate>
            </CollectionView.ItemTemplate>
          </CollectionView>
          <Label Text="{Binding SelectedFilledTab.Content}" />
        </VerticalStackLayout>
      </styling:Card>
    </VerticalStackLayout>
  </ScrollView>
</maui:ReactiveContentPage>
