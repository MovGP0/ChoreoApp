<?xml version="1.0" encoding="UTF-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    xmlns:choreoApp="clr-namespace:ChoreoApp.Styling;assembly=ChoreoApp.Styling">

  <!--
    Material Design 3 inspired toggle using the MAUI Switch control.
    Applies unified colors for On/Off/Disabled states using dynamic palette keys.
    Usage:
      <Switch Style="{StaticResource MaterialDesign3ToggleSwitchStyle}" />
      <Switch Style="{StaticResource MaterialDesign3ToggleSwitchStyle}"
              IsToggled="True" />
  -->

  <!-- default style (colors only) -->
  <Style TargetType="Switch">
    <Setter Property="OnColor" Value="{DynamicResource Key={x:Static choreoApp:MaterialDesignColorKey.Primary}}" />
    <Setter Property="ThumbColor" Value="{DynamicResource Key={x:Static choreoApp:MaterialDesignColorKey.OnPrimary}}" />
    <Setter Property="VisualStateManager.VisualStateGroups">
      <VisualStateGroupList>
        <VisualStateGroup x:Name="CommonStates">
          <VisualState x:Name="Normal" />
          <VisualState x:Name="Disabled">
            <VisualState.Setters>
              <Setter Property="OnColor" Value="{DynamicResource Key={x:Static choreoApp:MaterialDesignColorKey.OnSurfaceVariant}}" />
              <Setter Property="ThumbColor" Value="{DynamicResource Key={x:Static choreoApp:MaterialDesignColorKey.OnSurfaceVariant}}" />
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="On">
            <VisualState.Setters>
              <Setter Property="OnColor" Value="{DynamicResource Key={x:Static choreoApp:MaterialDesignColorKey.Secondary}}" />
              <Setter Property="ThumbColor" Value="{DynamicResource Key={x:Static choreoApp:MaterialDesignColorKey.OnPrimary}}" />
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="Off">
            <VisualState.Setters>
              <Setter Property="ThumbColor" Value="{DynamicResource Key={x:Static choreoApp:MaterialDesignColorKey.OutlineVariant}}" />
            </VisualState.Setters>
          </VisualState>
        </VisualStateGroup>
      </VisualStateGroupList>
    </Setter>
  </Style>
  
  <Style x:Key="MaterialDesign3ToggleSwitchStyle"
         TargetType="Switch">
    <Setter Property="BackgroundColor" Value="Transparent" />
    <Setter Property="ThumbColor" Value="{DynamicResource Key={x:Static choreoApp:MaterialDesignColorKey.OnSurface}}" />
    <Setter Property="OnColor" Value="{DynamicResource Key={x:Static choreoApp:MaterialDesignColorKey.Primary}}" />
    <Setter Property="MinimumHeightRequest" Value="36" />
    <Setter Property="MinimumWidthRequest" Value="52" />
    <Setter Property="Scale" Value="1" />
    <Setter Property="VisualStateManager.VisualStateGroups">
      <VisualStateGroupList>
        <VisualStateGroup x:Name="CommonStates">
          <VisualState x:Name="Normal" />
          <VisualState x:Name="Disabled">
            <VisualState.Setters>
              <Setter Property="OnColor"
                      Value="{DynamicResource Key={x:Static choreoApp:MaterialDesignColorKey.OnSurfaceVariant}}" />
              <Setter Property="ThumbColor"
                      Value="{DynamicResource Key={x:Static choreoApp:MaterialDesignColorKey.OnSurfaceVariant}}" />
              <Setter Property="Opacity" Value="0.38" />
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="On">
            <VisualState.Setters>
              <Setter Property="OnColor"
                      Value="{DynamicResource Key={x:Static choreoApp:MaterialDesignColorKey.Primary}}" />
              <Setter Property="ThumbColor"
                      Value="{DynamicResource Key={x:Static choreoApp:MaterialDesignColorKey.OnPrimary}}" />
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="Off">
            <VisualState.Setters>
              <Setter Property="OnColor"
                      Value="{DynamicResource Key={x:Static choreoApp:MaterialDesignColorKey.SurfaceVariant}}" />
              <Setter Property="ThumbColor"
                      Value="{DynamicResource Key={x:Static choreoApp:MaterialDesignColorKey.OutlineVariant}}" />
            </VisualState.Setters>
          </VisualState>
        </VisualStateGroup>
      </VisualStateGroupList>
    </Setter>
  </Style>

</ResourceDictionary>
