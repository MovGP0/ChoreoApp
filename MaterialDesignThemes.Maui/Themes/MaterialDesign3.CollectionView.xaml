<?xml version="1.0" encoding="UTF-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    xmlns:styling="clr-namespace:MaterialDesignThemes.Maui;assembly=MaterialDesignThemes.Maui">

  <Style x:Key="MaterialDesignCollectionView"
         TargetType="CollectionView">
    <Setter Property="BackgroundColor"
            Value="{DynamicResource Key={x:Static styling:MaterialDesignColorKey.Surface}}" />
    <Setter Property="styling:CollectionViewAssist.ItemPadding" Value="8" />
    <Setter Property="styling:CollectionViewAssist.AnimateSelection" Value="True" />
    <Setter Property="styling:CollectionViewAssist.SelectionAnimationDuration" Value="140" />
    <Setter Property="styling:CollectionViewAssist.SelectionScale" Value="0.96" />
  </Style>

  <Style TargetType="CollectionView"
         BasedOn="{StaticResource MaterialDesignCollectionView}" />
</ResourceDictionary>
